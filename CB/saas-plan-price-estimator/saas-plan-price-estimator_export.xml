                    <code><![CDATA[// ---- SaaS Plan Price Estimator ----
// $plan  Radio: 'starter' | 'pro' | 'business'      $seats    Number
// $addons Multiple option list: array of option values (empty when nothing is ticked)
// $billing Radio: 'monthly' | 'yearly' (yearly = 12 months for the price of 10)
// $nonprofit Yes/No: 'Y' when ticked, 'N' otherwise (20 % off the monthly price)

$plans = [
    'starter'  => ['Starter',  12],
    'pro'      => ['Pro',      24],
    'business' => ['Business', 42],
];
// key => [label, 'seat' (price per seat) or 'flat' (price per account), monthly price]
$addon_defs = [
    'support' => ['Priority support',      'seat', 3],
    'sso'     => ['Single sign-on (SSO)',  'flat', 99],
    'audit'   => ['Audit log',             'flat', 79],
    'storage' => ['Extra storage (+1 TB)', 'flat', 49],
];

$n      = max(1, min(10000, (int) $seats));
$pkey   = isset($plans[$plan]) ? $plan : 'pro';
$sel    = is_array($addons) ? $addons : explode(',', (string) $addons);
$yearly = ($billing === 'yearly');
$np     = ($nonprofit === 'Y');

$money = function ($v) { return ($v < 0 ? '-' : '') . '$' . number_format(abs($v), 2, '.', ','); };
$hero  = function ($v) { return '$' . number_format($v, (abs($v - round($v)) < 0.005) ? 0 : 2, '.', ','); };

// monthly list price of a given plan with the selected add-ons
$addon_month = 0;
$rows = '';
foreach ($addon_defs as $k => $d) {
    if (!in_array($k, $sel)) { continue; }
    $line = ($d[1] === 'seat') ? $d[2] * $n : $d[2];
    $addon_month += $line;
    $calc = ($d[1] === 'seat') ? number_format($n) . ' seats &times; ' . $money($d[2]) : 'flat fee';
    $rows .= '<tr><td>' . $d[0] . '</td><td class="c">' . $calc . '</td><td class="r">' . $money($line) . '</td></tr>';
}
$n_addons = count(array_filter(array_keys($addon_defs), function ($k) use ($sel) { return in_array($k, $sel); }));

$plan_month = $plans[$pkey][1] * $n;
$sub_month  = $plan_month + $addon_month;                       // list price per month
$np_disc    = $np ? round($sub_month * 0.20, 2) : 0;            // non-profit discount per month
$after_np   = $sub_month - $np_disc;                            // monthly price after the discount

if ($yearly) {
    $annual    = round($after_np * 10, 2);                      // 12 months for the price of 10
    $eff_month = round($annual / 12, 2);
} else {
    $annual    = round($after_np * 12, 2);
    $eff_month = $after_np;
}
$yr_disc   = $eff_month - $after_np;                            // negative number, per month equivalent
$list_year = $sub_month * 12;
$saved     = $list_year - $annual;
$per_seat  = $eff_month / $n;
$extra_2m  = round($after_np * 2, 2);                           // what yearly billing saves per year

// invoice-style table
$tbl  = '<table class="cbx-table dd-inv"><thead><tr><th>Item</th><th class="c">Calculation</th><th class="r">Per month</th></tr></thead><tbody>';
$tbl .= '<tr><td><b>' . $plans[$pkey][0] . ' plan</b></td><td class="c">' . number_format($n) . ' seats &times; ' . $money($plans[$pkey][1]) . '</td><td class="r">' . $money($plan_month) . '</td></tr>';
$tbl .= $rows;
$tbl .= '<tr class="sub"><td colspan="2">Subtotal (list price)</td><td class="r">' . $money($sub_month) . '</td></tr>';
if ($np)     { $tbl .= '<tr class="disc"><td colspan="2">Non-profit discount (20%)</td><td class="r">' . $money(-$np_disc) . '</td></tr>'; }
if ($yearly) { $tbl .= '<tr class="disc"><td colspan="2">Yearly billing: 2 months free</td><td class="r">' . $money($yr_disc) . '</td></tr>'; }
$tbl .= '<tr class="tot"><td colspan="2">Total per month' . ($yearly ? ' (effective)' : '') . '</td><td class="r">' . $money($eff_month) . '</td></tr>';
$tbl .= '<tr class="tot2"><td colspan="2">Total per year' . ($yearly ? ' (billed once)' : ' (12 payments)') . '</td><td class="r">' . $money($annual) . '</td></tr>';
$tbl .= '</tbody></table>';

// comparison of the three plans with the same seats, add-ons, billing and discount
$cmp = [];
$maxc = 0;
foreach ($plans as $k => $p) {
    $m = ($p[1] * $n + $addon_month) * ($np ? 0.8 : 1) * ($yearly ? 10 / 12 : 1);
    $cmp[$k] = round($m, 2);
    $maxc = max($maxc, $cmp[$k]);
}
$bars = '';
foreach ($plans as $k => $p) {
    $w = $maxc > 0 ? round($cmp[$k] / $maxc * 100, 1) : 0;
    $bars .= '<div class="dd-pl' . ($k === $pkey ? ' on' : '') . '"><span class="dd-pn">' . $p[0] . '</span>'
           . '<span class="dd-pb"><i style="width:' . $w . '%"></i></span><span class="dd-pv">' . $money($cmp[$k]) . '</span></div>';
}

// display strings (overwrite in place, as in the other examples)
$hero_month = $hero($eff_month);
$hero_year  = $hero($annual);
$sub_month_txt = $yearly ? 'Effective price, billed yearly' : 'Billed monthly';
$sub_year_txt  = $yearly ? 'Paid once a year. Yearly billing saves ' . $hero($extra_2m) . ' compared with paying monthly'
                         : 'Twelve monthly payments. Yearly billing would save ' . $hero($extra_2m);
$seat_price = $money($per_seat);
$saved_txt  = $hero($saved);
$plan_name  = $plans[$pkey][0];
$seats_txt  = number_format($n);
$addon_txt  = $n_addons . ($n_addons == 1 ? ' add-on' : ' add-ons');
$table      = $tbl;
$compare    = $bars;
$cmp_note   = ($yearly ? 'Effective monthly price, yearly billing' : 'Monthly price') . ($np ? ', non-profit discount applied' : '');
]]></code>

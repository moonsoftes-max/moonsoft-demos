                    <layout><![CDATA[<style>
.cbx-saas{--a:#4338ca;--a2:#818cf8;--soft:#eef2ff;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;color:var(--ink)}
.cbx-saas *{box-sizing:border-box}
.cbx-saas .cbx-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:1rem}
.cbx-saas .cbx-c12{grid-column:span 12}.cbx-saas .cbx-c6{grid-column:span 6}.cbx-saas .cbx-c4{grid-column:span 4}.cbx-saas .cbx-c3{grid-column:span 3}
@media(max-width:768px){.cbx-saas .cbx-c6,.cbx-saas .cbx-c4,.cbx-saas .cbx-c3{grid-column:span 12}}
.cbx-saas .cbx-sec{grid-column:span 12;display:flex;align-items:center;gap:.6rem;margin:.6rem 0 -.2rem;font-weight:700;font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;color:var(--a)}
.cbx-saas .cbx-sec:after{content:"";flex:1;height:1px;background:var(--line)}
.cbx-saas .cbx-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1rem 1.15rem;box-shadow:0 1px 2px rgba(15,23,42,.05);height:100%}
.cbx-saas .cbx-card label.cbx-l{display:block;font-weight:600;font-size:.92rem;margin-bottom:.4rem;color:var(--ink)}
.cbx-saas .cbx-card .cbx-h{font-size:.8rem;color:var(--muted);margin-top:.4rem;line-height:1.35}
.cbx-saas .cbx-card .form-control,.cbx-saas .cbx-card select{border:1px solid #cbd5e1;border-radius:10px;padding:.6rem .8rem;font-size:1rem;width:100%;background-color:#fff;height:auto}
.cbx-saas .cbx-card .form-control:focus,.cbx-saas .cbx-card select:focus{border-color:var(--a);box-shadow:0 0 0 .2rem #4338ca33;outline:0}
.cbx-saas .cbx-card .form-check{display:flex;align-items:center;gap:.55rem;margin:.25rem 0;padding-left:0}
.cbx-saas .cbx-card .form-check-input{float:none;margin:0;width:1.15rem;height:1.15rem;accent-color:var(--a);flex:0 0 auto}

                    <code><![CDATA[// ---- Event Catering Estimator (spreadsheet powered) ----
// Fields: $guests, $hours (Number), $menu (List 1-4), $service (Radio 1/2), $openbar (Yes/No),
// $extra_staff (Number), $venue (List 1-3). The workbook holds the price tables and does the maths.
// The //[EXCEL] marker below is replaced by Calc Builder with the code that writes the inputs into
// B5:B11, recalculates the workbook and reads the result cells (B14:B24) back into PHP variables.

// clean the inputs and turn the Yes/No checkbox into the 1/0 the sheet expects
$guests      = max(0, (int) $guests);
$hours       = max(0, (float) $hours);
$menu        = min(4, max(1, (int) $menu));
$service     = ((int) $service === 2) ? 2 : 1;
$extra_staff = max(0, (int) $extra_staff);
$venue       = min(3, max(1, (int) $venue));
$bar_flag    = (isset($openbar) && $openbar === 'Y') ? 1 : 0;

//[EXCEL]

// $objPHPExcel is the recalculated workbook; mapped outputs came back as formatted text ("14,358.52")
$num = function ($v) { return (float) str_replace([',', '%', ' '], '', (string) $v); };
$eur = function ($v, $d = 0) { return number_format((float) $v, $d, '.', ','); };

$c_food  = $num($food);
$c_drink = $num($drinks);
$c_staff = $num($staff_cost);
$c_venue = $num($venue_fee);
$c_up    = $num($uplift);
$c_sub   = $num($subtotal);
$c_vat   = $num($vat);
$c_total = $num($total);
$c_pg    = $num($per_guest);
$n_staff = (int) $num($staff_n);
$n_wait  = $n_staff - $extra_staff;
$price_head = $num($menu_price);

$menu_names  = [1 => 'Buffet', 2 => '3-course seated dinner', 3 => 'Cocktail canapes', 4 => 'BBQ'];
$venue_names = [1 => 'indoor hall', 2 => 'outdoor / garden', 3 => 'marquee'];
$menu_name   = $menu_names[$menu];
$venue_name  = $venue_names[$venue];
$service_name = ($service === 2) ? 'Premium service' : 'Standard service';

// cost breakdown: one bar per cost line, sized by its share of the total
$lines = [
    ['Food',            $c_food,  $menu_name . ' at &euro;' . $eur($price_head, 2) . ' per head'],
    ['Drinks',          $c_drink, $bar_flag ? 'Open bar for ' . rtrim(rtrim(number_format($hours, 1), '0'), '.') . ' h' : 'No open bar'],
    ['Staff',           $c_staff, $n_wait . ' waiters + ' . $extra_staff . ' extra, incl. set-up time'],
    ['Venue',           $c_venue, ucfirst($venue_name) . ' hire fee'],
    ['Service uplift',  $c_up,    $service_name . ' on food, drinks and staff'],
    ['VAT',             $c_vat,   'On the whole subtotal'],
];
$rows = '';
foreach ($lines as [$lab, $val, $desc]) {
    if ($lab === 'Service uplift' && $val <= 0) { continue; }
    $p = $c_total > 0 ? $val / $c_total * 100 : 0;
    $cls = ($val > 0) ? '' : ' off';
    $rows .= '<div class="cat-row' . $cls . '"><div class="cat-h"><span class="cat-n">' . $lab . '<small>' . $desc . '</small></span>'
           . '<span class="cat-v"><b>&euro;' . $eur($val) . '</b><em>' . number_format($p, 1) . '%</em></span></div>'
           . '<div class="cbx-bar"><span style="width:' . round($p, 1) . '%"></span></div></div>';
}
$breakdown = $rows;

// display strings (overwrite in place, like the other examples)
$total_f   = $eur($c_total, 2);
$pg_f      = $eur($c_pg, 2);
$sub_f     = $eur($c_sub);
$ph_f      = $eur($price_head, 2);
$pgh_f     = $eur($hours > 0 ? $c_pg / $hours : 0, 2);
$hours_f   = rtrim(rtrim(number_format($hours, 1), '0'), '.');
$guests_f  = $eur($guests);
$staff_txt = $n_staff . ' people';
$staff_sub = $n_wait . ' waiters + ' . $extra_staff . ' extra';
$hero_note = $guests_f . ' guests for ' . $hours_f . ' hours, VAT included';
$hero_pg   = $menu_name . ' &middot; ' . $service_name . ($bar_flag ? ' &middot; open bar' : '');
]]></code>

                    <code><![CDATA[// ---- Salary Take-Home Calculator (spreadsheet powered) ----
// Fields: $salary (Number), $freq (List 12/13/14), $status (Radio 1/2), $pension (Number %), $loan (Yes/No).
// The workbook holds the tax bands and does all the maths. The //[EXCEL] marker below is replaced by Calc
// Builder with the code that writes the five inputs into B5:B9, recalculates the workbook and reads the
// result cells (B12:B21) back into PHP variables.

// clean the inputs and turn the Yes/No checkbox into the 1/0 the sheet expects
$salary  = max(0, (float) $salary);
$freq    = in_array((int) $freq, [12, 13, 14], true) ? (int) $freq : 12;
$status  = ((int) $status === 2) ? 2 : 1;
$pension = max(0, min(100, (float) $pension));
$loan_flag = (isset($loan) && $loan === 'Y') ? 1 : 0;

//[EXCEL]

// $objPHPExcel is now the recalculated workbook: read the band-by-band rows (42-46) for the breakdown
$sheet = $objPHPExcel->getSheet(0);
$num = function ($v) { return (float) str_replace([',', '%', ' '], '', (string) $v); };
$eur = function ($v, $d = 0) { return number_format((float) $v, $d, '.', ','); };

$tax   = $num($tax_total);
$soc   = $num($social_amt);
$pen   = $num($pension_amt);
$ln    = $num($loan_amt);
$ded   = $num($total_ded);
$net   = $num($net_annual);
$netp  = $num($net_period);
$taxable = (float) $sheet->getCell("B38")->getCalculatedValue();
$allow   = (float) $sheet->getCell("B36")->getCalculatedValue();
$eff_pct  = (float) $sheet->getCell("B19")->getCalculatedValue() * 100;
$marg_pct = (float) $sheet->getCell("B21")->getCalculatedValue() * 100;
$band_pct = (float) $sheet->getCell("B20")->getCalculatedValue() * 100;

// tax table, one row per band
$rows = '';
for ($r = 42; $r <= 46; $r++) {
    $from  = (float) $sheet->getCell("B$r")->getCalculatedValue();
    $to    = $sheet->getCell("C$r")->getCalculatedValue();
    $rate  = (float) $sheet->getCell("D$r")->getCalculatedValue() * 100;
    $slice = (float) $sheet->getCell("E$r")->getCalculatedValue();
    $bt    = (float) $sheet->getCell("F$r")->getCalculatedValue();
    $range = is_numeric($to) ? $eur($from) . ' &ndash; ' . $eur($to) : $eur($from) . '+';
    $cls   = ($slice > 0) ? '' : ' class="off"';
    $rows .= '<tr' . $cls . '><td><b>Band ' . ($r - 41) . '</b><small>' . $range . '</small></td>'
           . '<td class="r">' . rtrim(rtrim(number_format($rate, 1), '0'), '.') . '%</td>'
           . '<td class="r">&euro;' . $eur($slice) . '</td>'
           . '<td class="r">&euro;' . $eur($bt) . '</td></tr>';
}
$rows .= '<tr class="tot"><td>Income tax</td><td></td><td class="r">&euro;' . $eur($taxable) . '</td><td class="r">&euro;' . $eur($tax) . '</td></tr>';
$band_table = '<table class="cbx-table sal-tbl"><thead><tr><th>Band (taxable income)</th><th class="r">Rate</th><th class="r">Taxed</th><th class="r">Tax</th></tr></thead><tbody>' . $rows . '</tbody></table>';

// stacked bar: where does the gross salary go?
$parts = [
    ['Net pay',              $net, '#15803d'],
    ['Income tax',           $tax, '#dc2626'],
    ['Social contributions', $soc, '#f97316'],
    ['Pension',              $pen, '#3b82f6'],
    ['Student loan',         $ln,  '#8b5cf6'],
];
$bar = '<div class="sal-stack" role="img" aria-label="Share of gross salary: net pay, tax, social contributions, pension, student loan">';
$leg = '<div class="sal-leg">';
foreach ($parts as [$lab, $val, $col]) {
    if ($val <= 0) { continue; }
    $p = $salary > 0 ? $val / $salary * 100 : 0;
    $bar .= '<div style="width:' . round($p, 2) . '%;background:' . $col . '" title="' . $lab . ' ' . round($p, 1) . '%">' . ($p >= 7 ? round($p) . '%' : '') . '</div>';
    $leg .= '<div class="li"><i style="background:' . $col . '"></i><span>' . $lab . '</span><b>&euro;' . $eur($val) . '</b><em>' . round($p, 1) . '%</em></div>';
}
$bar .= '</div>';
$leg .= '</div>';
$gross_bar = $bar . $leg;

// display strings (overwrite in place, like the other examples)
$pay_note   = $freq . ' payments a year' . ($loan_flag ? ', student loan included' : '');
$salary_f   = $eur($salary);
$net_f      = $eur($net);
$netp_f     = $eur($netp, 2);
$ded_f      = $eur($ded);
$taxable_f  = $eur($taxable);
$allow_f    = $eur($allow);
$eff_f      = number_format($eff_pct, 1, '.', '');
$marg_f     = number_format($marg_pct, 1, '.', '');
$band_f     = rtrim(rtrim(number_format($band_pct, 1), '0'), '.');
$status_f   = ($status === 2) ? 'Married' : 'Single';
$pension_f  = rtrim(rtrim(number_format($pension, 1, '.', ''), '0'), '.');
$pen_f      = $eur($pen);
$takehome_pct = number_format($salary > 0 ? $net / $salary * 100 : 0, 1, '.', '');
]]></code>

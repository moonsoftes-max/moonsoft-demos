.cbx-sal-res .sal-leg .li b{font-weight:700;text-align:right}
.cbx-sal-res .sal-leg .li em{font-style:normal;color:var(--muted);text-align:right;font-size:.82rem}
.cbx-sal-res .sal-tbl td small{display:block;color:var(--muted);font-size:.78rem;margin-top:.1rem}

                    <layout><![CDATA[<style>
.cbx-sal{--a:#15803d;--a2:#4ade80;--soft:#f0fdf4;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;color:var(--ink)}
.cbx-sal *{box-sizing:border-box}
.cbx-sal .cbx-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:1rem}
.cbx-sal .cbx-c12{grid-column:span 12}.cbx-sal .cbx-c6{grid-column:span 6}.cbx-sal .cbx-c4{grid-column:span 4}.cbx-sal .cbx-c3{grid-column:span 3}
@media(max-width:768px){.cbx-sal .cbx-c6,.cbx-sal .cbx-c4,.cbx-sal .cbx-c3{grid-column:span 12}}
.cbx-sal .cbx-sec{grid-column:span 12;display:flex;align-items:center;gap:.6rem;margin:.6rem 0 -.2rem;font-weight:700;font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;color:var(--a)}
.cbx-sal .cbx-sec:after{content:"";flex:1;height:1px;background:var(--line)}
.cbx-sal .cbx-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1rem 1.15rem;box-shadow:0 1px 2px rgba(15,23,42,.05);height:100%}
.cbx-sal .cbx-card label.cbx-l{display:block;font-weight:600;font-size:.92rem;margin-bottom:.4rem;color:var(--ink)}
.cbx-sal .cbx-card .cbx-h{font-size:.8rem;color:var(--muted);margin-top:.4rem;line-height:1.35}
.cbx-sal .cbx-card .form-control,.cbx-sal .cbx-card select{border:1px solid #cbd5e1;border-radius:10px;padding:.6rem .8rem;font-size:1rem;width:100%;background-color:#fff;height:auto}
.cbx-sal .cbx-card .form-control:focus,.cbx-sal .cbx-card select:focus{border-color:var(--a);box-shadow:0 0 0 .2rem #15803d33;outline:0}
.cbx-sal .cbx-card .form-check{display:flex;align-items:center;gap:.55rem;margin:.25rem 0;padding-left:0}
.cbx-sal .cbx-card .form-check-input{float:none;margin:0;width:1.15rem;height:1.15rem;accent-color:var(--a);flex:0 0 auto}
.cbx-sal .cbx-card textarea.form-control{min-height:90px}
.cbx-sal .cbx-card .radio,.cbx-sal .cbx-card .checkbox{margin:0}
.cbx-sal .cbx-card .radgroup{display:flex;flex-wrap:wrap;gap:.35rem 1.6rem}
.cbx-sal .cbx-card div[style*="float"]{float:none!important}
.cbx-sal .cbx-card input[data-type=yesno]{width:1.45rem;height:1.45rem;margin:0}
.cbx-sal .cbx-card label.radio,.cbx-sal .cbx-card label.form-check-label{margin:0;font-weight:500;cursor:pointer}
.cb_bootstrap .btcalctoolbar{float:none!important;width:100%!important;margin:1.4rem 0 1.6rem!important;text-align:center;padding:0}
.cb_bootstrap .row-fluid{width:100%}
.cb_bootstrap .btcalctoolbar input.btn.btn-primary{background:linear-gradient(135deg,#15803d,#4ade80);border:0;color:#fff;font-weight:700;font-size:1.05rem;padding:.8rem 2.4rem;border-radius:999px;box-shadow:0 6px 16px #15803d44;transition:transform .15s,box-shadow .15s;cursor:pointer}
.cb_bootstrap .btcalctoolbar input.btn.btn-primary:hover{transform:translateY(-1px);box-shadow:0 10px 22px #15803d55}
.cb_bootstrap .btcalctoolbar input.btn.btn-primary:focus-visible{outline:3px solid #15803d66;outline-offset:2px}
.cbx-sal-res{--a:#15803d;--a2:#4ade80;--soft:#f0fdf4;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;color:var(--ink)}
.cbx-sal-res .cbx-hero{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1rem;margin-bottom:1rem}
.cbx-sal-res .cbx-hero-card{position:relative;overflow:hidden;color:#fff;border-radius:16px;padding:1.4rem 1.5rem;background:linear-gradient(135deg,var(--a),var(--a2));box-shadow:0 8px 20px #15803d33}
.cbx-sal-res .cbx-hero-card:nth-child(2){background:linear-gradient(135deg,#0f172a,#334155);box-shadow:0 8px 20px rgba(15,23,42,.25)}
.cbx-sal-res .cbx-hero-card:nth-child(3){background:linear-gradient(135deg,var(--a2),var(--a))}
.cbx-sal-res .cbx-hero-card .cbx-ic{font-size:1.35rem;opacity:.9;margin-bottom:.6rem}
.cbx-sal-res .cbx-hero-card .cbx-lab{font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;opacity:.92;font-weight:600}
.cbx-sal-res .cbx-hero-card .cbx-val{font-size:2.35rem;font-weight:800;line-height:1.15;margin:.2rem 0 .3rem;letter-spacing:-.01em}
.cbx-sal-res .cbx-hero-card .cbx-sub{font-size:.88rem;opacity:.92}
.cbx-sal-res .cbx-hero-card:after{content:"";position:absolute;right:-30px;top:-30px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.1)}
.cbx-sal-res .cbx-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:.9rem;margin-bottom:1rem}
.cbx-sal-res .cbx-metric{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1rem 1.1rem;box-shadow:0 1px 2px rgba(15,23,42,.05)}
.cbx-sal-res .cbx-metric .cbx-ic{color:var(--a);font-size:1.15rem;margin-bottom:.45rem}
.cbx-sal-res .cbx-metric .cbx-lab{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.cbx-sal-res .cbx-metric .cbx-val{font-size:1.45rem;font-weight:800;margin-top:.15rem;line-height:1.2}
.cbx-sal-res .cbx-panel{background:var(--soft);border:1px solid var(--line);border-radius:14px;padding:1.1rem 1.25rem;margin-bottom:1rem}
.cbx-sal-res .cbx-panel h4{font-size:.95rem;font-weight:700;margin:0 0 .7rem;color:var(--a)}
.cbx-sal-res .cbx-bar{height:12px;border-radius:999px;background:#e2e8f0;overflow:hidden;position:relative}
.cbx-sal-res .cbx-bar>span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--a2),var(--a))}
.cbx-sal-res .cbx-row{display:flex;justify-content:space-between;gap:1rem;padding:.45rem 0;border-bottom:1px dashed var(--line);font-size:.95rem}
.cbx-sal-res .cbx-row:last-child{border-bottom:0}
.cbx-sal-res .cbx-row b{font-weight:700}
.cbx-sal-res .cbx-table{width:100%;border-collapse:collapse;font-size:.92rem}
.cbx-sal-res .cbx-table th{text-align:left;font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:.5rem .6rem;border-bottom:2px solid var(--line)}
.cbx-sal-res .cbx-table td{padding:.5rem .6rem;border-bottom:1px solid var(--line)}
.cbx-sal-res .cbx-table .r{text-align:right}
.cbx-sal-res .cbx-gaugewrap{position:relative;padding-top:8px}
.cbx-sal-res .cbx-gauge{display:flex;height:14px;border-radius:999px;overflow:hidden}
.cbx-sal-res .cbx-gauge i{display:block;height:100%}
.cbx-sal-res .cbx-pin{position:absolute;top:0;width:5px;height:30px;background:#0f172a;border-radius:3px;transform:translateX(-50%);box-shadow:0 0 0 2px #fff}
.cbx-sal-res .cbx-ticks{position:relative;height:1.3rem;margin:.4rem 12px 0;font-size:.78rem;color:var(--muted)}
.cbx-sal-res .cbx-ticks span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.cbx-sal-res .cbx-chart{display:flex;align-items:flex-end;gap:3px;height:190px;padding-top:6px;border-bottom:2px solid var(--line)}
.cbx-sal-res .cbx-col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;height:100%;min-width:0}
.cbx-sal-res .cbx-col .sa{background:var(--a)}
.cbx-sal-res .cbx-col .sb{background:var(--a2);border-radius:4px 4px 0 0}
.cbx-sal-res .cbx-xl{display:flex;gap:3px;font-size:.7rem;color:var(--muted);margin-top:.3rem}
.cbx-sal-res .cbx-xl span{flex:1;text-align:center;min-width:0;overflow:visible;white-space:nowrap}
.cbx-sal-res .cbx-legend{display:flex;gap:1.2rem;font-size:.82rem;color:var(--muted);margin-top:.7rem;flex-wrap:wrap}
.cbx-sal-res .cbx-legend i{display:inline-block;width:.7rem;height:.7rem;border-radius:3px;margin-right:.4rem;vertical-align:-1px}
.cbx-sal-res .cbx-note{font-size:.85rem;color:var(--muted);border-top:1px dashed #cbd5e1;padding-top:.8rem;margin:.4rem 0 0}
.cbx-sal-res .cbx-badge{display:inline-block;border-radius:999px;padding:.2rem .7rem;font-size:.78rem;font-weight:700;background:var(--soft);color:var(--a);border:1px solid var(--a)}
</style>
<div class="cbx-sal"><div class="cbx-grid">
<div class="cbx-sec">Your pay</div>
<div class="cbx-c6"><div class="cbx-card"><label class="cbx-l">Gross annual salary (&euro;)</label>##salary##<div class="cbx-h">Your yearly salary before tax and any other deduction.</div></div></div>
<div class="cbx-c6"><div class="cbx-card"><label class="cbx-l">Pay frequency</label>##freq##<div class="cbx-h">How many payments you receive per year (some countries pay 13 or 14).</div></div></div>
<div class="cbx-sec">Tax situation and deductions</div>
<div class="cbx-c4"><div class="cbx-card"><label class="cbx-l">Filing status</label>##status##<div class="cbx-h">Married filers get a higher personal allowance in this model.</div></div></div>
<div class="cbx-c4"><div class="cbx-card"><label class="cbx-l">Pension contribution (% of gross)</label>##pension##<div class="cbx-h">Comes out of your pay and reduces your taxable income (up to a limit).</div></div></div>
<div class="cbx-c4"><div class="cbx-card"><label class="cbx-l">Student loan</label>##loan##<div class="cbx-h">Tick if you repay a student loan (9% of salary above &euro;27,000).</div></div></div>
</div></div>]]></layout>
                    <exitlayout><![CDATA[<div class="cbx-sal-res">
<p style="margin:0 0 .8rem"><span class="cbx-badge">Powered by an Excel workbook</span></p>
<div class="cbx-hero">
<div class="cbx-hero-card"><div class="cbx-ic"><i class="fa fa-wallet" aria-hidden="true"></i></div><div class="cbx-lab">Net pay per payment</div><div class="cbx-val">&euro;##netp_f##</div><div class="cbx-sub">##pay_note##</div></div>
<div class="cbx-hero-card"><div class="cbx-ic"><i class="fa fa-piggy-bank" aria-hidden="true"></i></div><div class="cbx-lab">Net annual take-home</div><div class="cbx-val">&euro;##net_f##</div><div class="cbx-sub">You keep ##takehome_pct##% of your &euro;##salary_f## gross</div></div>
</div>
<div class="cbx-metrics">
<div class="cbx-metric"><div class="cbx-ic"><i class="fa fa-scissors" aria-hidden="true"></i></div><div class="cbx-lab">Total deductions</div><div class="cbx-val">&euro;##ded_f##</div></div>
<div class="cbx-metric"><div class="cbx-ic"><i class="fa fa-percent" aria-hidden="true"></i></div><div class="cbx-lab">Effective tax rate</div><div class="cbx-val">##eff_f##%</div></div>
<div class="cbx-metric"><div class="cbx-ic"><i class="fa fa-arrow-trend-up" aria-hidden="true"></i></div><div class="cbx-lab">Marginal rate</div><div class="cbx-val">##marg_f##%</div></div>
<div class="cbx-metric"><div class="cbx-ic"><i class="fa fa-vault" aria-hidden="true"></i></div><div class="cbx-lab">Pension saved</div><div class="cbx-val">&euro;##pen_f##</div></div>
</div>
<style>
.cbx-sal-res .sal-stack{display:flex;height:44px;border-radius:12px;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(15,23,42,.08)}
.cbx-sal-res .sal-stack>div{display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:.85rem;min-width:0;overflow:hidden;white-space:nowrap;border-right:2px solid #fff}
.cbx-sal-res .sal-stack>div:last-child{border-right:0}

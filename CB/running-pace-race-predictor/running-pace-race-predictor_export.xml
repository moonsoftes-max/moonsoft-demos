                    <code><![CDATA[// ---- Running Pace & Race Predictor ----
// $refdist = List value (distance in km), $hours / $minutes / $seconds = the reference finishing time.
$d1 = (float) $refdist;
if ($d1 <= 0) { $d1 = 10; }
$t1 = max(0, (int) $hours) * 3600 + max(0, (int) $minutes) * 60 + max(0, (float) $seconds);
if ($t1 <= 0) { $t1 = 1; }

$km_per_mile = 1.609344;
$pace_km   = $t1 / $d1;                       // seconds per km
$pace_mi   = $pace_km * $km_per_mile;         // seconds per mile
$speed_kmh = 3600 / $pace_km;
$speed_mph = $speed_kmh / $km_per_mile;

// helpers: seconds -> h:mm:ss  and  seconds -> m:ss
$hms = function ($s) {
    $s = (int) round($s);
    $h = intdiv($s, 3600); $m = intdiv($s % 3600, 60); $x = $s % 60;
    return $h > 0 ? sprintf('%d:%02d:%02d', $h, $m, $x) : sprintf('%d:%02d', $m, $x);
};
$ms = function ($s) {
    $s = (int) round($s);
    return sprintf('%d:%02d', intdiv($s, 60), $s % 60);
};

// Riegel: T2 = T1 * (D2 / D1) ^ 1.06
$races = [
    ['5K',            5.0],
    ['10K',          10.0],
    ['Half marathon', 21.0975],
    ['Marathon',     42.195],
];
$pred = [];
$rows = '';
foreach ($races as $r) {
    $t2 = $t1 * pow($r[1] / $d1, 1.06);
    $pred[$r[0]] = $t2;
    $is_ref = abs($r[1] - $d1) < 0.001;
    $rows .= '<tr' . ($is_ref ? ' class="ref"' : '') . '><td>' . $r[0] . ($is_ref ? ' <span class="cbx-badge">Your result</span>' : '') . '</td>'
           . '<td class="r">' . $hms($t2) . '</td>'
           . '<td class="r">' . $ms($t2 / $r[1]) . '</td>'
           . '<td class="r">' . $ms($t2 / $r[1] * $km_per_mile) . '</td></tr>';
}
$pred_rows = $rows;

// pace zones from the predicted race paces (seconds per km)
$p5   = $pred['5K'] / 5;
$p10  = $pred['10K'] / 10;
$phm  = $pred['Half marathon'] / 21.0975;
$pmar = $pred['Marathon'] / 42.195;
$zones = [
    ['Easy',           $ms($pmar * 1.25) . '&ndash;' . $ms($pmar * 1.10), '#bae6fd'],
    ['Marathon pace',  $ms($pmar),                                      '#7dd3fc'],
    ['Half marathon',  $ms($phm),                                       '#fcd34d'],
    ['10K pace',       $ms($p10),                                       '#fbbf24'],
    ['5K pace',        $ms($p5),                                        '#f59e0b'],
    ['Speed reps',     $ms($p5 * 0.96),                                 '#b45309'],
];
$bar = '<div class="cbx-zonebar" role="img" aria-label="Pace zones from easy to fast">';
$grid = '<div class="cbx-zones">';
foreach ($zones as $z) {
    $bar  .= '<i style="background:' . $z[2] . '"></i>';
    $grid .= '<div class="z"><span class="dot" style="background:' . $z[2] . '"></span><b>' . $z[0] . '</b><span>' . $z[1] . ' /km</span></div>';
}
$bar  .= '</div>';
$grid .= '</div>';
$zone_html = $bar . $grid;

// display strings
$names = ['5' => '5K', '10' => '10K', '21.0975' => 'Half marathon', '42.195' => 'Marathon'];
$ref_name = isset($names[$refdist]) ? $names[$refdist] : rtrim(rtrim(number_format($d1, 3, '.', ''), '0'), '.') . ' km';
$pace_km_f  = $ms($pace_km);
$pace_mi_f  = $ms($pace_mi);
$speed_kmh_f = number_format($speed_kmh, 1);
$speed_mph_f = number_format($speed_mph, 1);
$ref_time_f = $hms($t1);
$miles_f    = number_format($d1 / $km_per_mile, 2);
$lap_f      = $ms($pace_km * 0.4);
$five_f     = $hms($pred['5K']);
$half_f     = $hms($pred['Half marathon']);
$mar_f      = $hms($pred['Marathon']);
$ref_name_f = $ref_name;
]]></code>

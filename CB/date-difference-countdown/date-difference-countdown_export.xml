                    <code><![CDATA[// ---- Date Difference & Countdown ----
// $date_start / $date_end are Date fields. The frontend datepicker sends plain TEXT in the calculator's
// date format (d-m-Y, e.g. 21-09-2026) and Calc Builder does NOT validate it: users can type anything,
// so we parse strictly ourselves. $incl_end is 'Y' when ticked, 'N' otherwise; $workweek is '5', '6' or '7'.

$parse = function ($s) {
    $s = str_replace(['/', '.'], '-', trim((string) $s));
    foreach (['!d-m-Y', '!Y-m-d'] as $fmt) {
        $dt  = DateTime::createFromFormat($fmt, $s);
        $err = DateTime::getLastErrors();                       // false or array; rejects 31-02-2027 (rolled over)
        if ($dt && (!$err || ($err['warning_count'] == 0 && $err['error_count'] == 0))
            && (int) $dt->format('Y') >= 1900 && (int) $dt->format('Y') <= 2200) {
            return $dt;
        }
    }
    return null;
};
$plural = function ($n, $word) { return number_format($n) . ' ' . $word . ($n == 1 ? '' : 's'); };

$A = $parse($date_start);
$B = $parse($date_end);
$ok = ($A !== null && $B !== null);

$work_n     = ($workweek === '7') ? 7 : (($workweek === '6') ? 6 : 5);
$week_label = [5 => 'Monday to Friday', 6 => 'Monday to Saturday', 7 => 'Every day of the week'][$work_n];
$names      = [1 => 'Monday', 2 => 'Tuesday', 3 => 'Wednesday', 4 => 'Thursday', 5 => 'Friday', 6 => 'Saturday', 7 => 'Sunday'];

$warn = '';
$res_style = '';
$notice = '';

if (!$ok) {
    $warn = '<div class="dd-warn"><strong>Check the dates.</strong> Please enter both dates as day-month-year, for example 21-09-2026. '
          . 'Impossible dates such as 31-02-2027 are rejected.</div>';
    $res_style = 'display:none';
    $total_days = $weeks_days = $months_days = $working = $non_working = $hours = '-';
    $sub_total = $sub_work = $range_from = $range_to = $range_note = '';
    $cd_y = $cd_m = $cd_d = 0;
    $cd_yl = 'Years'; $cd_ml = 'Months'; $cd_dl = 'Days';
    $wd_bars = '';
} else {
    $swapped = ($A > $B);
    if ($swapped) { $tmp = $A; $A = $B; $B = $tmp; }
    $incl = ($incl_end === 'Y');

    // the range is [A, X): X is the end date itself, or the day after it when the end date is included
    $X = clone $B;
    if ($incl) { $X->modify('+1 day'); }

    $iv    = $A->diff($X);                   // calendar-aware years / months / days
    $total = (int) $iv->days;                // exact number of days
    $weeks = intdiv($total, 7);
    $wrem  = $total % 7;
    $mon_total = $iv->y * 12 + $iv->m;

    // how many of each weekday fall in the range: full weeks give one each, the remainder is walked day by day
    $first_dow = (int) $A->format('N');      // 1 = Monday ... 7 = Sunday
    $cnt = array_fill(1, 7, $weeks);
    for ($i = 0; $i < $wrem; $i++) { $cnt[(($first_dow - 1 + $i) % 7) + 1]++; }
    $work = 0;
    for ($dw = 1; $dw <= $work_n; $dw++) { $work += $cnt[$dw]; }
    $off = $total - $work;

    if ($swapped) { $notice = '<div class="dd-warn dd-info">The end date is earlier than the start date, so the two dates were swapped.</div>'; }
    $warn = $notice;

    // weekday bars
    $maxc = max($cnt);
    $pct_work = $total > 0 ? round($work / $total * 100, 1) : 0;
    $pct_off  = round(100 - $pct_work, 1);
    $wd_bars  = '<div class="dd-split"><i class="w" style="width:' . $pct_work . '%"></i><i class="o" style="width:' . $pct_off . '%"></i></div>'
              . '<div class="dd-leg"><span><i class="w"></i>Working days: <b>' . number_format($work) . '</b> (' . round($pct_work) . '%)</span>'
              . '<span><i class="o"></i>Non-working days: <b>' . number_format($off) . '</b> (' . round($pct_off) . '%)</span></div>'
              . '<div class="dd-chips">';
    foreach ($names as $dw => $nm) {
        $wd_bars .= '<div class="dd-chip ' . ($dw <= $work_n ? 'w' : 'o') . '"><span>' . substr($nm, 0, 3) . '</span><b>' . number_format($cnt[$dw]) . '</b></div>';
    }
    $wd_bars .= '</div>';

    $range_from = $A->format('D, j M Y');
    $range_to   = $B->format('D, j M Y');
    $range_note = $incl ? 'End date counted' : 'End date not counted';

    $cd_y = $iv->y; $cd_m = $iv->m; $cd_d = $iv->d;
    $cd_yl = $cd_y == 1 ? 'Year' : 'Years'; $cd_ml = $cd_m == 1 ? 'Month' : 'Months'; $cd_dl = $cd_d == 1 ? 'Day' : 'Days';
    $sub_total = $plural($weeks, 'week') . ' and ' . $plural($wrem, 'day');
    $sub_work  = $week_label . '. Public holidays are not excluded.';

    // display strings (overwrite in place, as in the other examples)
    $total_days   = number_format($total);
    $weeks_days   = $plural($weeks, 'week') . ', ' . $plural($wrem, 'day');
    $months_days  = $plural($mon_total, 'month') . ', ' . $plural($iv->d, 'day');
    $working      = number_format($work);
    $non_working  = number_format($off);
    $hours        = number_format($total * 24);
}
]]></code>

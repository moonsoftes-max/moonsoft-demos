                    <code><![CDATA[// ---- Rental Property Yield ----
// All inputs are Number fields. Amounts are in $, rates in % per year.
$price   = max(0, (float) $price);
$dep_pct = max(0, min(100, (float) $deposit));
$rate    = max(0, (float) $rate);
$years   = max(1, (int) $years);
$rent    = max(0, (float) $rent);
$costs_m = max(0, (float) $costs);
$tax_y   = max(0, (float) $tax);
$vac_pct = max(0, min(100, (float) $vacancy));

// --- mortgage: standard amortising payment on (price - deposit) ---
$cash_in = $price * $dep_pct / 100;          // deposit = cash you put in
$loan    = $price - $cash_in;
$n       = $years * 12;
$r       = $rate / 100 / 12;
if ($loan <= 0)      { $pay = 0; }
elseif ($r == 0)     { $pay = $loan / $n; }
else                 { $pay = $loan * $r / (1 - pow(1 + $r, -$n)); }

// --- yearly income and expenses ---
$rent_y   = $rent * 12;                       // gross scheduled rent
$vac_loss = $rent_y * $vac_pct / 100;         // rent lost to empty periods
$costs_y  = $costs_m * 12;                    // maintenance, insurance...
$opex     = $costs_y + $tax_y;                // operating expenses (no mortgage)
$noi      = $rent_y - $vac_loss - $opex;      // net operating income
$debt_y   = $pay * 12;
$cf_y     = $noi - $debt_y;                   // annual cash flow after mortgage
$cf_m     = $cf_y / 12;

$gross_yield = $price > 0 ? $rent_y / $price * 100 : 0;
$net_yield   = $price > 0 ? $noi / $price * 100 : 0;      // cap rate
$coc         = $cash_in > 0 ? $cf_y / $cash_in * 100 : 0; // cash-on-cash return

// yield band for the gauge (0-10 % scale)
if     ($net_yield < 3) { $band = 'Low yield'; }
elseif ($net_yield < 5) { $band = 'Fair yield'; }
elseif ($net_yield < 7) { $band = 'Good yield'; }
else                    { $band = 'Excellent yield'; }
$pct = max(0, min(100, $net_yield / 10 * 100));

// stacked bar: where each year of gross rent goes (a negative cash flow has no green slice)
$parts = [
    ['Vacancy',           $vac_loss,       '#94a3b8'],
    ['Running costs',     $costs_y,        '#f59e0b'],
    ['Property tax',      $tax_y,          '#f97316'],
    ['Mortgage',          $debt_y,         '#1d4ed8'],
    ['Cash flow to you',  max($cf_y, 0),   '#22c55e'],
];
$total = 0;
foreach ($parts as $p) { $total += $p[1]; }
$bar = '<div class="cbx-stack" role="img" aria-label="Where the annual rent goes">';
$leg = '<div class="cbx-legend">';
foreach ($parts as $p) {
    $w = $total > 0 ? round($p[1] / $total * 100, 2) : 0;
    if ($w > 0) { $bar .= '<i style="width:' . $w . '%;background:' . $p[2] . '"></i>'; }
    $leg .= '<span><i style="background:' . $p[2] . '"></i>' . $p[0] . ' $' . number_format($p[1], 0, '.', ',') . '</span>';
}
$bar .= '</div>';
$leg .= '</div>';
$stack = $bar . $leg;
$stack_note = ($cf_y < 0)
    ? 'Rent after vacancy and costs does not cover the mortgage: you top up about $' . number_format(-$cf_m, 0, '.', ',') . ' per month.'
    : 'After every cost and the mortgage you keep about ' . number_format($rent_y > 0 ? $cf_y / $rent_y * 100 : 0, 0) . '% of the gross rent.';

// display strings (overwritten in place)
$money = function ($v) { return ($v < 0 ? '-$' : '$') . number_format(abs($v), 0, '.', ','); };
$pay_f      = $money($pay);
$cf_m_f     = $money($cf_m);
$cf_y_f     = $money($cf_y);
$noi_f      = $money($noi);
$rent_y_f   = $money($rent_y);
$loan_f     = $money($loan);
$cash_in_f  = $money($cash_in);
$gross_f    = number_format($gross_yield, 2, '.', ',');
$net_f      = number_format($net_yield, 2, '.', ',');
$coc_f      = number_format($coc, 2, '.', ',');
$cf_sign    = $cf_y >= 0 ? 'Positive cash flow after the mortgage' : 'Negative cash flow after the mortgage';
$pct        = number_format($pct, 1, '.', '');
$dep_f      = rtrim(rtrim(number_format($dep_pct, 1, '.', ''), '0'), '.');
$rate_f     = rtrim(rtrim(number_format($rate, 2, '.', ''), '0'), '.');
$years_f    = $years;
]]></code>

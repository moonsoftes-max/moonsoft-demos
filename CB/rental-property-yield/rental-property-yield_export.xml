.cbx-rent-res .cbx-row{display:flex;justify-content:space-between;gap:1rem;padding:.45rem 0;border-bottom:1px dashed var(--line);font-size:.95rem}
.cbx-rent-res .cbx-row:last-child{border-bottom:0}
.cbx-rent-res .cbx-row b{font-weight:700}
.cbx-rent-res .cbx-table{width:100%;border-collapse:collapse;font-size:.92rem}
.cbx-rent-res .cbx-table th{text-align:left;font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:.5rem .6rem;border-bottom:2px solid var(--line)}
.cbx-rent-res .cbx-table td{padding:.5rem .6rem;border-bottom:1px solid var(--line)}
.cbx-rent-res .cbx-table .r{text-align:right}
.cbx-rent-res .cbx-gaugewrap{position:relative;padding-top:8px}
.cbx-rent-res .cbx-gauge{display:flex;height:14px;border-radius:999px;overflow:hidden}
.cbx-rent-res .cbx-gauge i{display:block;height:100%}
.cbx-rent-res .cbx-pin{position:absolute;top:0;width:5px;height:30px;background:#0f172a;border-radius:3px;transform:translateX(-50%);box-shadow:0 0 0 2px #fff}
.cbx-rent-res .cbx-ticks{position:relative;height:1.3rem;margin:.4rem 12px 0;font-size:.78rem;color:var(--muted)}
.cbx-rent-res .cbx-ticks span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.cbx-rent-res .cbx-chart{display:flex;align-items:flex-end;gap:3px;height:190px;padding-top:6px;border-bottom:2px solid var(--line)}
.cbx-rent-res .cbx-col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;height:100%;min-width:0}
.cbx-rent-res .cbx-col .sa{background:var(--a)}
.cbx-rent-res .cbx-col .sb{background:var(--a2);border-radius:4px 4px 0 0}
.cbx-rent-res .cbx-xl{display:flex;gap:3px;font-size:.7rem;color:var(--muted);margin-top:.3rem}
.cbx-rent-res .cbx-xl span{flex:1;text-align:center;min-width:0;overflow:visible;white-space:nowrap}
.cbx-rent-res .cbx-legend{display:flex;gap:1.2rem;font-size:.82rem;color:var(--muted);margin-top:.7rem;flex-wrap:wrap}
.cbx-rent-res .cbx-legend i{display:inline-block;width:.7rem;height:.7rem;border-radius:3px;margin-right:.4rem;vertical-align:-1px}
.cbx-rent-res .cbx-note{font-size:.85rem;color:var(--muted);border-top:1px dashed #cbd5e1;padding-top:.8rem;margin:.4rem 0 0}

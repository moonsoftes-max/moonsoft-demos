                    <code><![CDATA[// ---- BMI & Healthy Weight Range ----
// $unit is the selected radio value ('metric' or 'imperial'); $height / $weight are Number fields.
$h = (float) $height;
$w = (float) $weight;

if ($unit === 'imperial') {          // inches / pounds
    $h_m  = $h * 0.0254;
    $w_kg = $w * 0.45359237;
    $u_w  = 'lb';
    $u_h  = 'in';
    $factor = 2.20462;
} else {                              // centimetres / kilograms
    $h_m  = $h / 100;
    $w_kg = $w;
    $u_w  = 'kg';
    $u_h  = 'cm';
    $factor = 1;
}

$bmi_raw = ($h_m > 0) ? $w_kg / ($h_m * $h_m) : 0;

if     ($bmi_raw < 18.5) { $category = 'Underweight'; $advice = 'Below the healthy range. Consider talking to a health professional about a balanced plan.'; }
elseif ($bmi_raw < 25)   { $category = 'Healthy weight'; $advice = 'You are within the healthy range for your height. Keep it up.'; }
elseif ($bmi_raw < 30)   { $category = 'Overweight'; $advice = 'Slightly above the healthy range. Small, steady changes in activity and diet help.'; }
else                     { $category = 'Obesity'; $advice = 'Well above the healthy range. A health professional can help you build a safe plan.'; }

// healthy weight window for this height (BMI 18.5 - 24.9)
$min_w = 18.5 * $h_m * $h_m * $factor;
$max_w = 24.9 * $h_m * $h_m * $factor;

// position on the 15-40 BMI scale (0-100 %) for the gauge marker
$pct = max(0, min(100, ($bmi_raw - 15) / 25 * 100));

// difference to the healthy window
if ($w_kg * $factor > $max_w)      { $delta = number_format($w_kg * $factor - $max_w, 1) . ' ' . $u_w . ' above the healthy maximum'; }
elseif ($w_kg * $factor < $min_w)  { $delta = number_format($min_w - $w_kg * $factor, 1) . ' ' . $u_w . ' below the healthy minimum'; }
else                               { $delta = 'Inside the healthy window'; }

// display strings (same in-place convention as the other examples)
$bmi       = number_format($bmi_raw, 1, '.', ',');
$min_w     = number_format($min_w, 1, '.', ',');
$max_w     = number_format($max_w, 1, '.', ',');
$pct       = number_format($pct, 1, '.', '');
$unit_w    = $u_w;
$unit_h    = $u_h;
]]></code>

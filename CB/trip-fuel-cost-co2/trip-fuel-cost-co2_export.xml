                    <code><![CDATA[// ---- Trip Fuel Cost & CO2 ----
// $fuel = List value (petrol / diesel / hybrid / electric), $roundtrip = 'Y' when ticked.
$dist_in = max(0, (float) $distance);
$cons    = max(0, (float) $consumption);     // L/100 km, or kWh/100 km for electric
$price   = max(0, (float) $fuelprice);       // $ per L, or $ per kWh for electric
$pax     = max(1, (int) $passengers);
$rt      = ($roundtrip === 'Y');

// kg CO2 per litre (or per kWh), and typical consumption / price used for the comparison bars
$fuels = [
    'petrol'   => ['Petrol',   2.31, 'L',   7.5, 1.75],
    'diesel'   => ['Diesel',   2.68, 'L',   6.0, 1.65],
    'hybrid'   => ['Hybrid',   2.31, 'L',   4.8, 1.75],
    'electric' => ['Electric', 0.23, 'kWh', 17.0, 0.28],
];
$key = isset($fuels[$fuel]) ? $fuel : 'petrol';
list($fname, $co2f, $unit, , ) = $fuels[$key];

$km      = $dist_in * ($rt ? 2 : 1);
$energy  = $km * $cons / 100;                // litres or kWh
$cost    = $energy * $price;
$co2     = $energy * $co2f;                  // kg
$cost_pp = $cost / $pax;
$co2_pp  = $co2 / $pax;
$trees   = $co2 / 21;                        // one tree absorbs about 21 kg CO2 per year
$per100  = $km > 0 ? $cost / $km * 100 : 0;
$gkm     = $km > 0 ? $co2 * 1000 / $km : 0;

// comparison: the selected fuel uses the visitor's own numbers, the others a typical vehicle
$cmp = [];
foreach ($fuels as $k => $f) {
    if ($k === $key) { $c = $cost; $g = $co2; }
    else { $e = $km * $f[3] / 100; $c = $e * $f[4]; $g = $e * $f[1]; }
    $cmp[$k] = [$f[0], $c, $g];
}
$maxc = 0; $maxg = 0;
foreach ($cmp as $r) { $maxc = max($maxc, $r[1]); $maxg = max($maxg, $r[2]); }
$mk = function ($idx, $max, $fmt) use ($cmp, $key) {
    $out = '';
    foreach ($cmp as $k => $r) {
        $w = $max > 0 ? round($r[$idx] / $max * 100, 1) : 0;
        $cls = ($k === $key) ? ' class="me"' : '';
        $out .= '<div class="cbx-cmp"><span class="n">' . $r[0] . ($k === $key ? ' (yours)' : '') . '</span>'
              . '<span class="t"><i' . $cls . ' style="width:' . max($w, 1.5) . '%"></i></span>'
              . '<span class="v">' . $fmt($r[$idx]) . '</span></div>';
    }
    return $out;
};
$cmp_cost = $mk(1, $maxc, function ($v) { return '$' . number_format($v, 0, '.', ','); });
$cmp_co2  = $mk(2, $maxg, function ($v) { return number_format($v, 0, '.', ',') . ' kg'; });

// the lowest-emission option of the four
$best = $key; $bestg = $cmp[$key][2];
foreach ($cmp as $k => $r) { if ($r[2] < $bestg) { $best = $k; $bestg = $r[2]; } }
if ($best === $key) {
    $advice = $fname . ' is already the lowest-emission option in this comparison.';
} else {
    $save_c = $cost - $cmp[$best][1];
    $save_g = $co2 - $cmp[$best][2];
    $advice = 'The same trip in a typical ' . strtolower($cmp[$best][0]) . ' vehicle would emit about ' . number_format($save_g, 0, '.', ',')
            . ' kg less CO2 (' . round($co2 > 0 ? $save_g / $co2 * 100 : 0) . '%) and ' . ($save_c >= 0 ? 'cost about $' . number_format($save_c, 0, '.', ',') . ' less.' : 'cost about $' . number_format(-$save_c, 0, '.', ',') . ' more.');
}

// display strings
$energy_f  = number_format($energy, 1, '.', ',');
$unit_f    = $unit;
$km_f      = number_format($km, 0, '.', ',');
$cost_f    = number_format($cost, 2, '.', ',');
$cost_pp_f = number_format($cost_pp, 2, '.', ',');
$co2_f     = number_format($co2, 1, '.', ',');
$co2_pp_f  = number_format($co2_pp, 1, '.', ',');
$trees_f   = number_format($trees, 1, '.', ',');
$per100_f  = number_format($per100, 2, '.', ',');
$gkm_f     = number_format($gkm, 0, '.', ',');
$fname_f   = $fname;
$pax_f     = $pax;
$trip_f    = $rt ? 'Round trip' : 'One way';
$price_f   = number_format($price, 2, '.', ',');
$people_f  = $pax == 1 ? '1 person' : $pax . ' people';
]]></code>

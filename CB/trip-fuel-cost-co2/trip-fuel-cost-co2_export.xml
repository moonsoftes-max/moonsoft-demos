                    <layout><![CDATA[<style>
.cbx-trip{--a:#0e7490;--a2:#22d3ee;--soft:#ecfeff;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;color:var(--ink)}
.cbx-trip *{box-sizing:border-box}
.cbx-trip .cbx-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:1rem}
.cbx-trip .cbx-c12{grid-column:span 12}.cbx-trip .cbx-c6{grid-column:span 6}.cbx-trip .cbx-c4{grid-column:span 4}.cbx-trip .cbx-c3{grid-column:span 3}
@media(max-width:768px){.cbx-trip .cbx-c6,.cbx-trip .cbx-c4,.cbx-trip .cbx-c3{grid-column:span 12}}
.cbx-trip .cbx-sec{grid-column:span 12;display:flex;align-items:center;gap:.6rem;margin:.6rem 0 -.2rem;font-weight:700;font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;color:var(--a)}
.cbx-trip .cbx-sec:after{content:"";flex:1;height:1px;background:var(--line)}
.cbx-trip .cbx-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1rem 1.15rem;box-shadow:0 1px 2px rgba(15,23,42,.05);height:100%}
.cbx-trip .cbx-card label.cbx-l{display:block;font-weight:600;font-size:.92rem;margin-bottom:.4rem;color:var(--ink)}
.cbx-trip .cbx-card .cbx-h{font-size:.8rem;color:var(--muted);margin-top:.4rem;line-height:1.35}
.cbx-trip .cbx-card .form-control,.cbx-trip .cbx-card select{border:1px solid #cbd5e1;border-radius:10px;padding:.6rem .8rem;font-size:1rem;width:100%;background-color:#fff;height:auto}
.cbx-trip .cbx-card .form-control:focus,.cbx-trip .cbx-card select:focus{border-color:var(--a);box-shadow:0 0 0 .2rem #0e749033;outline:0}
.cbx-trip .cbx-card .form-check{display:flex;align-items:center;gap:.55rem;margin:.25rem 0;padding-left:0}
.cbx-trip .cbx-card .form-check-input{float:none;margin:0;width:1.15rem;height:1.15rem;accent-color:var(--a);flex:0 0 auto}
.cbx-trip .cbx-card textarea.form-control{min-height:90px}
.cbx-trip .cbx-card .radio,.cbx-trip .cbx-card .checkbox{margin:0}
.cbx-trip .cbx-card .radgroup{display:flex;flex-wrap:wrap;gap:.35rem 1.6rem}
.cbx-trip .cbx-card div[style*="float"]{float:none!important}
.cbx-trip .cbx-card input[data-type=yesno]{width:1.45rem;height:1.45rem;margin:0}
.cbx-trip .cbx-card label.radio,.cbx-trip .cbx-card label.form-check-label{margin:0;font-weight:500;cursor:pointer}
.cb_bootstrap .btcalctoolbar{float:none!important;width:100%!important;margin:1.4rem 0 1.6rem!important;text-align:center;padding:0}
.cb_bootstrap .row-fluid{width:100%}
.cb_bootstrap .btcalctoolbar input.btn.btn-primary{background:linear-gradient(135deg,#0e7490,#22d3ee);border:0;color:#fff;font-weight:700;font-size:1.05rem;padding:.8rem 2.4rem;border-radius:999px;box-shadow:0 6px 16px #0e749044;transition:transform .15s,box-shadow .15s;cursor:pointer}
.cb_bootstrap .btcalctoolbar input.btn.btn-primary:hover{transform:translateY(-1px);box-shadow:0 10px 22px #0e749055}
.cb_bootstrap .btcalctoolbar input.btn.btn-primary:focus-visible{outline:3px solid #0e749066;outline-offset:2px}
.cbx-trip-res{--a:#0e7490;--a2:#22d3ee;--soft:#ecfeff;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;color:var(--ink)}
.cbx-trip-res .cbx-hero{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1rem;margin-bottom:1rem}
.cbx-trip-res .cbx-hero-card{position:relative;overflow:hidden;color:#fff;border-radius:16px;padding:1.4rem 1.5rem;background:linear-gradient(135deg,var(--a),var(--a2));box-shadow:0 8px 20px #0e749033}
.cbx-trip-res .cbx-hero-card:nth-child(2){background:linear-gradient(135deg,#0f172a,#334155);box-shadow:0 8px 20px rgba(15,23,42,.25)}
.cbx-trip-res .cbx-hero-card:nth-child(3){background:linear-gradient(135deg,var(--a2),var(--a))}
.cbx-trip-res .cbx-hero-card .cbx-ic{font-size:1.35rem;opacity:.9;margin-bottom:.6rem}
.cbx-trip-res .cbx-hero-card .cbx-lab{font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;opacity:.92;font-weight:600}
.cbx-trip-res .cbx-hero-card .cbx-val{font-size:2.35rem;font-weight:800;line-height:1.15;margin:.2rem 0 .3rem;letter-spacing:-.01em}
.cbx-trip-res .cbx-hero-card .cbx-sub{font-size:.88rem;opacity:.92}
.cbx-trip-res .cbx-hero-card:after{content:"";position:absolute;right:-30px;top:-30px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.1)}
.cbx-trip-res .cbx-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:.9rem;margin-bottom:1rem}
.cbx-trip-res .cbx-metric{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1rem 1.1rem;box-shadow:0 1px 2px rgba(15,23,42,.05)}
.cbx-trip-res .cbx-metric .cbx-ic{color:var(--a);font-size:1.15rem;margin-bottom:.45rem}
.cbx-trip-res .cbx-metric .cbx-lab{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.cbx-trip-res .cbx-metric .cbx-val{font-size:1.45rem;font-weight:800;margin-top:.15rem;line-height:1.2}
.cbx-trip-res .cbx-panel{background:var(--soft);border:1px solid var(--line);border-radius:14px;padding:1.1rem 1.25rem;margin-bottom:1rem}
.cbx-trip-res .cbx-panel h4{font-size:.95rem;font-weight:700;margin:0 0 .7rem;color:var(--a)}
.cbx-trip-res .cbx-bar{height:12px;border-radius:999px;background:#e2e8f0;overflow:hidden;position:relative}
.cbx-trip-res .cbx-bar>span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--a2),var(--a))}
.cbx-trip-res .cbx-row{display:flex;justify-content:space-between;gap:1rem;padding:.45rem 0;border-bottom:1px dashed var(--line);font-size:.95rem}
.cbx-trip-res .cbx-row:last-child{border-bottom:0}
.cbx-trip-res .cbx-row b{font-weight:700}
.cbx-trip-res .cbx-table{width:100%;border-collapse:collapse;font-size:.92rem}
.cbx-trip-res .cbx-table th{text-align:left;font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:.5rem .6rem;border-bottom:2px solid var(--line)}
.cbx-trip-res .cbx-table td{padding:.5rem .6rem;border-bottom:1px solid var(--line)}
.cbx-trip-res .cbx-table .r{text-align:right}
.cbx-trip-res .cbx-gaugewrap{position:relative;padding-top:8px}
.cbx-trip-res .cbx-gauge{display:flex;height:14px;border-radius:999px;overflow:hidden}
.cbx-trip-res .cbx-gauge i{display:block;height:100%}
.cbx-trip-res .cbx-pin{position:absolute;top:0;width:5px;height:30px;background:#0f172a;border-radius:3px;transform:translateX(-50%);box-shadow:0 0 0 2px #fff}
.cbx-trip-res .cbx-ticks{position:relative;height:1.3rem;margin:.4rem 12px 0;font-size:.78rem;color:var(--muted)}
.cbx-trip-res .cbx-ticks span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.cbx-trip-res .cbx-chart{display:flex;align-items:flex-end;gap:3px;height:190px;padding-top:6px;border-bottom:2px solid var(--line)}
.cbx-trip-res .cbx-col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;height:100%;min-width:0}
.cbx-trip-res .cbx-col .sa{background:var(--a)}
.cbx-trip-res .cbx-col .sb{background:var(--a2);border-radius:4px 4px 0 0}
.cbx-trip-res .cbx-xl{display:flex;gap:3px;font-size:.7rem;color:var(--muted);margin-top:.3rem}
.cbx-trip-res .cbx-xl span{flex:1;text-align:center;min-width:0;overflow:visible;white-space:nowrap}
.cbx-trip-res .cbx-legend{display:flex;gap:1.2rem;font-size:.82rem;color:var(--muted);margin-top:.7rem;flex-wrap:wrap}
.cbx-trip-res .cbx-legend i{display:inline-block;width:.7rem;height:.7rem;border-radius:3px;margin-right:.4rem;vertical-align:-1px}
.cbx-trip-res .cbx-note{font-size:.85rem;color:var(--muted);border-top:1px dashed #cbd5e1;padding-top:.8rem;margin:.4rem 0 0}
.cbx-trip-res .cbx-badge{display:inline-block;border-radius:999px;padding:.2rem .7rem;font-size:.78rem;font-weight:700;background:var(--soft);color:var(--a);border:1px solid var(--a)}
</style>
<div class="cbx-trip"><div class="cbx-grid">
<div class="cbx-sec">The trip</div>
<div class="cbx-c4"><div class="cbx-card"><label class="cbx-l">Distance (km, one way)</label>##distance##<div class="cbx-h">Length of the journey in kilometres.</div></div></div>
<div class="cbx-c4"><div class="cbx-card"><label class="cbx-l">Passengers</label>##passengers##<div class="cbx-h">People sharing the vehicle, driver included.</div></div></div>
<div class="cbx-c4"><div class="cbx-card"><label class="cbx-l">Round trip?</label>##roundtrip##<div class="cbx-h">Ticked: the distance is doubled for the way back.</div></div></div>
<div class="cbx-sec">Vehicle and fuel</div>
<div class="cbx-c6"><div class="cbx-card"><label class="cbx-l">Fuel type</label>##fuel##<div class="cbx-h">Each option shows its CO&#8322; emissions per litre or kWh.</div></div></div>
<div class="cbx-c3"><div class="cbx-card"><label class="cbx-l">Consumption per 100 km</label>##consumption##<div class="cbx-h">Litres per 100 km, or kWh per 100 km if electric.</div></div></div>
<div class="cbx-c3"><div class="cbx-card"><label class="cbx-l">Fuel price ($ per unit)</label>##fuelprice##<div class="cbx-h">Price per litre, or per kWh when charging.</div></div></div>
</div></div><script>(function(){var c=document.querySelector('input[fldname="roundtrip"]');if(c&&!c.dataset.cbxInit){c.dataset.cbxInit=1;c.checked=true;}})();</script>]]></layout>

.cbx-be-res .cbx-row:last-child{border-bottom:0}
.cbx-be-res .cbx-row b{font-weight:700}
.cbx-be-res .cbx-table{width:100%;border-collapse:collapse;font-size:.92rem}
.cbx-be-res .cbx-table th{text-align:left;font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:.5rem .6rem;border-bottom:2px solid var(--line)}
.cbx-be-res .cbx-table td{padding:.5rem .6rem;border-bottom:1px solid var(--line)}
.cbx-be-res .cbx-table .r{text-align:right}
.cbx-be-res .cbx-gaugewrap{position:relative;padding-top:8px}
.cbx-be-res .cbx-gauge{display:flex;height:14px;border-radius:999px;overflow:hidden}
.cbx-be-res .cbx-gauge i{display:block;height:100%}
.cbx-be-res .cbx-pin{position:absolute;top:0;width:5px;height:30px;background:#0f172a;border-radius:3px;transform:translateX(-50%);box-shadow:0 0 0 2px #fff}
.cbx-be-res .cbx-ticks{position:relative;height:1.3rem;margin:.4rem 12px 0;font-size:.78rem;color:var(--muted)}
.cbx-be-res .cbx-ticks span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.cbx-be-res .cbx-chart{display:flex;align-items:flex-end;gap:3px;height:190px;padding-top:6px;border-bottom:2px solid var(--line)}
.cbx-be-res .cbx-col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;height:100%;min-width:0}
.cbx-be-res .cbx-col .sa{background:var(--a)}
.cbx-be-res .cbx-col .sb{background:var(--a2);border-radius:4px 4px 0 0}
.cbx-be-res .cbx-xl{display:flex;gap:3px;font-size:.7rem;color:var(--muted);margin-top:.3rem}
.cbx-be-res .cbx-xl span{flex:1;text-align:center;min-width:0;overflow:visible;white-space:nowrap}
.cbx-be-res .cbx-legend{display:flex;gap:1.2rem;font-size:.82rem;color:var(--muted);margin-top:.7rem;flex-wrap:wrap}
.cbx-be-res .cbx-legend i{display:inline-block;width:.7rem;height:.7rem;border-radius:3px;margin-right:.4rem;vertical-align:-1px}
.cbx-be-res .cbx-note{font-size:.85rem;color:var(--muted);border-top:1px dashed #cbd5e1;padding-top:.8rem;margin:.4rem 0 0}
.cbx-be-res .cbx-badge{display:inline-block;border-radius:999px;padding:.2rem .7rem;font-size:.78rem;font-weight:700;background:var(--soft);color:var(--a);border:1px solid var(--a)}
</style>
<div class="cbx-be"><div class="cbx-grid">
<div class="cbx-sec">Your costs</div>
<div class="cbx-c6"><div class="cbx-card"><label class="cbx-l">Fixed costs ($ / month)</label>##fixed##<div class="cbx-h">Rent, salaries, software: costs that do not change with volume.</div></div></div>

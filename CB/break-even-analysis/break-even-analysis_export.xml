                    <layout><![CDATA[<style>
.cbx-be{--a:#334155;--a2:#64748b;--soft:#f8fafc;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;color:var(--ink)}
.cbx-be *{box-sizing:border-box}
.cbx-be .cbx-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:1rem}
.cbx-be .cbx-c12{grid-column:span 12}.cbx-be .cbx-c6{grid-column:span 6}.cbx-be .cbx-c4{grid-column:span 4}.cbx-be .cbx-c3{grid-column:span 3}
@media(max-width:768px){.cbx-be .cbx-c6,.cbx-be .cbx-c4,.cbx-be .cbx-c3{grid-column:span 12}}
.cbx-be .cbx-sec{grid-column:span 12;display:flex;align-items:center;gap:.6rem;margin:.6rem 0 -.2rem;font-weight:700;font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;color:var(--a)}
.cbx-be .cbx-sec:after{content:"";flex:1;height:1px;background:var(--line)}
.cbx-be .cbx-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1rem 1.15rem;box-shadow:0 1px 2px rgba(15,23,42,.05);height:100%}
.cbx-be .cbx-card label.cbx-l{display:block;font-weight:600;font-size:.92rem;margin-bottom:.4rem;color:var(--ink)}
.cbx-be .cbx-card .cbx-h{font-size:.8rem;color:var(--muted);margin-top:.4rem;line-height:1.35}
.cbx-be .cbx-card .form-control,.cbx-be .cbx-card select{border:1px solid #cbd5e1;border-radius:10px;padding:.6rem .8rem;font-size:1rem;width:100%;background-color:#fff;height:auto}
.cbx-be .cbx-card .form-control:focus,.cbx-be .cbx-card select:focus{border-color:var(--a);box-shadow:0 0 0 .2rem #33415533;outline:0}
.cbx-be .cbx-card .form-check{display:flex;align-items:center;gap:.55rem;margin:.25rem 0;padding-left:0}
.cbx-be .cbx-card .form-check-input{float:none;margin:0;width:1.15rem;height:1.15rem;accent-color:var(--a);flex:0 0 auto}
.cbx-be .cbx-card textarea.form-control{min-height:90px}
.cbx-be .cbx-card .radio,.cbx-be .cbx-card .checkbox{margin:0}
.cbx-be .cbx-card .radgroup{display:flex;flex-wrap:wrap;gap:.35rem 1.6rem}
.cbx-be .cbx-card div[style*="float"]{float:none!important}
.cbx-be .cbx-card input[data-type=yesno]{width:1.45rem;height:1.45rem;margin:0}
.cbx-be .cbx-card label.radio,.cbx-be .cbx-card label.form-check-label{margin:0;font-weight:500;cursor:pointer}
.cb_bootstrap .btcalctoolbar{float:none!important;width:100%!important;margin:1.4rem 0 1.6rem!important;text-align:center;padding:0}

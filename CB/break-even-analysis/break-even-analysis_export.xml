                    <code><![CDATA[// ---- Break-even Analysis ----
// $fixed = fixed costs per month, $price = selling price per unit, $varcost = variable cost per unit,
// $units = expected units sold per month.
$F = max(0, (float) $fixed);
$P = max(0, (float) $price);
$V = max(0, (float) $varcost);
$U = max(0, (float) $units);
$fm = function ($v, $d = 0) { return number_format($v, $d, '.', ','); };

$cm    = $P - $V;                                   // contribution margin per unit
$cm_pc = ($P > 0) ? $cm / $P * 100 : 0;             // contribution margin ratio
$ok    = ($cm > 0);                                 // a break-even point exists only if each sale contributes
$be_u  = $ok ? $F / $cm : 0;                        // break-even units (exact)
$be_i  = (int) ceil($be_u - 1e-9);                  // whole units needed to cover the fixed costs
$be_r  = $ok ? $F / ($cm_pc / 100) : 0;             // break-even revenue

$rev    = $U * $P;
$cost   = $F + $U * $V;
$profit = $rev - $cost;                             // expected monthly profit = units x margin - fixed costs

// margin of safety: how far sales can fall before profit hits zero
$mos_u  = $U - $be_u;
$mos_pc = ($ok && $U > 0) ? $mos_u / $U * 100 : 0;

// ---- chart: revenue versus cost at 0, 0.25 ... 2 times the break-even volume ----
$base = ($ok && $be_u > 0) ? $be_u : max(100, $U);
$maxv = max(2 * $base * $P, $F + 2 * $base * $V, 1);
$bars = ''; $xl = '';
for ($k = 0; $k <= 8; $k++) {
    $u  = $base * $k / 4;
    $hr = round($u * $P / $maxv * 100, 2);
    $hc = round(($F + $u * $V) / $maxv * 100, 2);
    $bars .= '<div class="be-g' . ($ok && $k === 4 ? ' hl' : '') . '" title="' . $fm($u) . ' units">'
           . '<div class="be-r" style="height:' . $hr . '%"></div>'
           . '<div class="be-c" style="height:' . $hc . '%"><div class="v" style="flex:' . round($u * $V, 2) . ' 0 0"></div><div class="f" style="flex:' . round($F, 2) . ' 0 0"></div></div></div>';
    $xl   .= '<span>' . ($k % 2 !== 0 ? '' : (($ok && $k === 4) ? $fm($be_i) : $fm($u))) . '</span>';
}
$tag = $ok ? '<div class="be-tag">Break-even</div>' : '';
$chart = '<div class="be-chart" role="img" aria-label="Revenue versus total cost at different sales volumes">' . $tag . $bars . '</div><div class="be-xl" aria-hidden="true">' . $xl . '</div>';

// ---- safety gauge: loss zone / profit zone with a pin at the expected sales ----
if ($ok) {
    $scale = max($be_u, $U) * 1.3;
    $loss_w = round($be_u / $scale * 100, 1);
    $pin   = round(min(100, $U / $scale * 100), 1);
    $lab   = max(14, min(86, $pin));
    $safety = '<div class="be-top"><span style="left:' . $lab . '%">Expected ' . $fm($U) . '</span></div>'
        . '<div class="cbx-gaugewrap"><div class="cbx-gauge"><i style="width:' . $loss_w . '%;background:#f87171"></i><i style="width:' . (100 - $loss_w) . '%;background:#34d399"></i></div>'
        . '<div class="cbx-pin" style="left:' . $pin . '%"></div></div>'
        . '<div class="cbx-ticks"><span style="left:0">0</span><span style="left:' . $loss_w . '%">Break-even ' . $fm($be_i) . '</span></div>';
    if ($U >= $be_u) { $advice = 'Sales can fall by <strong>' . $fm($mos_u) . ' units</strong> (' . $fm($mos_pc, 1) . '% or $' . $fm($mos_u * $P) . ' of revenue) before you stop making a profit.'; }
    else             { $advice = 'Expected sales are <strong>' . $fm($be_u - $U) . ' units</strong> below break-even, so each month loses money. Raise the price, cut costs or sell more.'; }
} else {
    $safety = '';
    $advice = 'The price is not above the variable cost, so every sale loses money and there is no break-even point. Raise the price or lower the variable cost.';
}

// display strings
$be_units   = $ok ? $fm($be_i) : 'n/a';
$be_rev     = $ok ? '$' . $fm($be_r) : 'n/a';
$rev_f      = $fm($rev);
$cost_f     = $fm($cost);
$units_f    = $fm($U);
$cm_f       = ($cm < 0 ? '-$' : '$') . $fm(abs($cm), 2);
$cm_pc_f    = $fm($cm_pc, 1) . '%';
$mos_f      = $ok ? $fm($mos_pc, 1) . '%' : 'n/a';
$profit_lab = ($profit >= 0) ? 'Expected monthly profit' : 'Expected monthly loss';
$profit_f   = ($profit < 0 ? '-$' : '$') . $fm(abs($profit));
$profit_sub = $units_f . ' units earn $' . $rev_f . ' of revenue against $' . $cost_f . ' of costs';
]]></code>

.cb_bootstrap .btcalctoolbar input.btn.btn-primary{background:linear-gradient(135deg,#334155,#64748b);border:0;color:#fff;font-weight:700;font-size:1.05rem;padding:.8rem 2.4rem;border-radius:999px;box-shadow:0 6px 16px #33415544;transition:transform .15s,box-shadow .15s;cursor:pointer}

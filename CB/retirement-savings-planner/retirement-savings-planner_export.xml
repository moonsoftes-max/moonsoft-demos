                    <code><![CDATA[// ---- Retirement Savings Planner ----
// Number fields: $cur_age, $ret_age, $savings, $contrib (per month), $ret_rate (%), $infl (%), $income (target per month, today's money)
// Yes/No field:  $real_terms is 'Y' when ticked ("show values in today's money"), otherwise 'N'.
$age0  = max(16, min(80, (int) $cur_age));
$age1  = max($age0 + 1, min(90, (int) $ret_age));
$n     = $age1 - $age0;                            // years to retirement
$S     = max(0, (float) $savings);
$C     = max(0, (float) $contrib);
$g     = max(0, min(15, (float) $ret_rate)) / 100; // annual return
$inf   = max(0, min(10, (float) $infl)) / 100;     // annual inflation
$T     = max(0, (float) $income);                  // wanted monthly income, today's money
$real  = ($real_terms === 'Y');
$r     = $g / 12;                                  // monthly return

// month-by-month projection (contribution added at the end of every month), yearly snapshots
$bal = $S;
$years = [];
for ($m = 1; $m <= $n * 12; $m++) {
    $bal = $bal * (1 + $r) + $C;
    if ($m % 12 === 0) { $years[] = $bal; }
}
$F      = $bal;                                    // nest egg in future dollars
$infn   = pow(1 + $inf, $n);
$F_real = $F / $infn;                              // same pot in today's money
$paid   = $S + $C * 12 * $n;                       // cash actually paid in

// 4% rule: sustainable withdrawal = 4% of the pot per year
$inc_nom  = $F * 0.04 / 12;
$inc_real = $inc_nom / $infn;
$T_nom    = $T * $infn;                            // target income expressed in future dollars
$need_nom = $T_nom * 12 / 0.04;                    // pot needed to fund it
$need_real = $T * 12 / 0.04;

// values shown in the chosen "money" (today's or future)
$nest_v = $real ? $F_real : $F;
$inc_v  = $real ? $inc_real : $inc_nom;
$tgt_v  = $real ? $T : $T_nom;
$need_v = $real ? $need_real : $need_nom;
$gap    = $tgt_v - $inc_v;

// extra monthly saving needed to reach the target pot (flat monthly amount, future dollars)
$fac = ($r > 0) ? (pow(1 + $r, $n * 12) - 1) / $r : $n * 12;
$extra = ($F < $need_nom && $fac > 0) ? ($need_nom - $F) / $fac : 0;
$funded = ($tgt_v > 0) ? $inc_v / $tgt_v * 100 : 100;

// year-by-year stacked bars (paid in + growth), in the chosen money; dashed line = pot needed
$rows = []; $max = $need_v;
foreach ($years as $i => $b) {
    $k  = $i + 1;
    $d  = $real ? pow(1 + $inf, $k) : 1;
    $pd = ($S + $C * 12 * $k) / $d;
    $bv = $b / $d;
    $rows[] = [$age0 + $k, min($pd, $bv), max(0, $bv - $pd)];
    $max = max($max, $bv);
}
$chart = '<div class="cbx-chart" role="img" aria-label="Projected balance by age, contributions and growth">';
$labels = '<div class="cbx-xl" aria-hidden="true">';
foreach ($rows as $j => [$ag, $pd, $gr]) {
    $hp = $max > 0 ? round($pd / $max * 100, 1) : 0;
    $hg = $max > 0 ? round($gr / $max * 100, 1) : 0;
    $chart .= '<div class="cbx-col" title="Age ' . $ag . '"><div class="sb" style="height:' . $hg . '%"></div><div class="sa" style="height:' . $hp . '%"></div></div>';
    $show = ($ag % 5 === 0 && ($n - ($j + 1) >= 3 || $j + 1 === $n)) || ($j + 1 === $n) || ($j === 0 && ((5 - $age0 % 5) % 5) >= 3 + 1);
    $labels .= '<span>' . ($show ? $ag : '') . '</span>';
}
$tline = $max > 0 ? round($need_v / $max * 100, 1) : 0;
$chart .= '<div class="ret-target" style="bottom:calc(' . $tline . ' * 1.82px)"><span>Target pot $' . number_format($need_v, 0, '.', ',') . '</span></div>';
$chart .= '</div>' . $labels . '</div>';

// display strings
$mode      = $real ? "today's money" : 'future dollars';
$alt_lab   = $real ? 'future dollars' : "today's money";
$alt_val   = number_format($real ? $F : $F_real, 0, '.', ',');
$nest      = number_format($nest_v, 0, '.', ',');
$income_m  = number_format($inc_v, 0, '.', ',');
$target_m  = number_format($tgt_v, 0, '.', ',');
if ($gap > 0.5) { $gap_lab = 'Monthly shortfall'; $gap_val = '$' . number_format($gap, 0, '.', ','); $gap_sub = 'Below your target of $' . $target_m . ' a month'; }
else            { $gap_lab = 'Monthly surplus';   $gap_val = '+$' . number_format(-$gap, 0, '.', ','); $gap_sub = 'Above your target of $' . $target_m . ' a month'; }
$extra_f   = ($extra > 0.5) ? '$' . number_format($extra, 0, '.', ',') . ' / mo' : 'On track';
$funded_f  = number_format(min(999, $funded), 0, '.', ',');
$paid_f    = number_format($paid, 0, '.', ',');
$growth_f  = number_format(($F > 0) ? max(0, $F - $paid) / $F * 100 : 0, 0, '.', ',');
$ret_age   = $age1;
$years_to  = $n;
]]></code>

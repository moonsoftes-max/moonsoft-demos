                    <code><![CDATA[// ---- Daily Calorie & Macro Planner ----
// $sex = radio value (male|female); $age, $height (cm), $weight (kg) = Number fields;
// $activity = activity multiplier (list value); $goal = lose|maintain|gain (list value).
$a = max(15, min(100, (float) $age));
$h = max(100, min(250, (float) $height));
$w = max(30, min(300, (float) $weight));
$mult = (float) $activity;

// Mifflin-St Jeor basal metabolic rate
$bmr_raw = 10 * $w + 6.25 * $h - 5 * $a + ($sex === 'female' ? -161 : 5);
$tdee_raw = $bmr_raw * $mult;

// goal: calorie adjustment, protein per kg of body weight, fat share of calories
if ($goal === 'lose')      { $adj = -500; $prot_kg = 2.0; $fat_share = 0.25; $goal_text = 'Calories for steady weight loss (about 500 below maintenance)'; }
elseif ($goal === 'gain')  { $adj = 300;  $prot_kg = 1.8; $fat_share = 0.25; $goal_text = 'Calories for lean weight gain (about 300 above maintenance)'; }
else                       { $adj = 0;    $prot_kg = 1.6; $fat_share = 0.30; $goal_text = 'Calories to maintain your current weight'; }

$tdee_i   = (int) round($tdee_raw);
$target_i = (int) round($tdee_raw + $adj);

// never recommend less than a safe minimum
$floor = ($sex === 'female') ? 1200 : 1500;
$warn = '';
if ($target_i < $floor) {
    $target_i = $floor;
    $warn = '<p class="cbx-note">The target was raised to ' . number_format($floor) . ' kcal, a commonly used safe minimum. Very low intakes should be supervised by a professional.</p>';
}

// macros: protein by body weight, fat by share of calories, carbohydrate = the rest
$prot_g = (int) round($w * $prot_kg);
$fat_g  = (int) round($target_i * $fat_share / 9);
$prot_k = $prot_g * 4;
$fat_k  = $fat_g * 9;
$carb_k = max(0, $target_i - $prot_k - $fat_k);
$carb_g = (int) round($carb_k / 4);
$sum_k  = max(1, $prot_k + $fat_k + $carb_k);
$p_pct  = (int) round($prot_k / $sum_k * 100);
$f_pct  = (int) round($fat_k / $sum_k * 100);
$c_pct  = 100 - $p_pct - $f_pct;

// expected weekly change (about 7,700 kcal per kg of body weight)
$wk = ($target_i - $tdee_raw) * 7 / 7700;
if (abs($wk) < 0.005) { $weekly = 'Stable weight'; }
else                  { $weekly = ($wk > 0 ? '+' : '-') . number_format(abs($wk), 2) . ' kg/wk'; }

// display strings
$act_names = ['1.2' => 'Sedentary', '1.375' => 'Lightly active', '1.55' => 'Moderately active', '1.725' => 'Very active', '1.9' => 'Extra active'];
$act_label = isset($act_names[(string) $activity]) ? $act_names[(string) $activity] : 'Custom';
$bmr       = number_format($bmr_raw, 0, '.', ',');
$tdee      = number_format($tdee_i, 0, '.', ',');
$target    = number_format($target_i, 0, '.', ',');
$mult      = rtrim(rtrim(number_format($mult, 3, '.', ''), '0'), '.');
$prot_kg_f = number_format($prot_kg, 1, '.', '');
$prot_k    = number_format($prot_k, 0, '.', ',');
$carb_k    = number_format($carb_k, 0, '.', ',');
$fat_k     = number_format($fat_k, 0, '.', ',');
]]></code>

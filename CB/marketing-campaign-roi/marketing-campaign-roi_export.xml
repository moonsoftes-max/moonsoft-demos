.cbx-mkt{--a:#be123c;--a2:#fb7185;--soft:#fff1f2;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;color:var(--ink)}
.cbx-mkt *{box-sizing:border-box}
.cbx-mkt .cbx-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:1rem}
.cbx-mkt .cbx-c12{grid-column:span 12}.cbx-mkt .cbx-c6{grid-column:span 6}.cbx-mkt .cbx-c4{grid-column:span 4}.cbx-mkt .cbx-c3{grid-column:span 3}
@media(max-width:768px){.cbx-mkt .cbx-c6,.cbx-mkt .cbx-c4,.cbx-mkt .cbx-c3{grid-column:span 12}}
.cbx-mkt .cbx-sec{grid-column:span 12;display:flex;align-items:center;gap:.6rem;margin:.6rem 0 -.2rem;font-weight:700;font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;color:var(--a)}
.cbx-mkt .cbx-sec:after{content:"";flex:1;height:1px;background:var(--line)}
.cbx-mkt .cbx-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1rem 1.15rem;box-shadow:0 1px 2px rgba(15,23,42,.05);height:100%}
.cbx-mkt .cbx-card label.cbx-l{display:block;font-weight:600;font-size:.92rem;margin-bottom:.4rem;color:var(--ink)}
.cbx-mkt .cbx-card .cbx-h{font-size:.8rem;color:var(--muted);margin-top:.4rem;line-height:1.35}
.cbx-mkt .cbx-card .form-control,.cbx-mkt .cbx-card select{border:1px solid #cbd5e1;border-radius:10px;padding:.6rem .8rem;font-size:1rem;width:100%;background-color:#fff;height:auto}
.cbx-mkt .cbx-card .form-control:focus,.cbx-mkt .cbx-card select:focus{border-color:var(--a);box-shadow:0 0 0 .2rem #be123c33;outline:0}
.cbx-mkt .cbx-card .form-check{display:flex;align-items:center;gap:.55rem;margin:.25rem 0;padding-left:0}
.cbx-mkt .cbx-card .form-check-input{float:none;margin:0;width:1.15rem;height:1.15rem;accent-color:var(--a);flex:0 0 auto}
.cbx-mkt .cbx-card textarea.form-control{min-height:90px}
.cbx-mkt .cbx-card .radio,.cbx-mkt .cbx-card .checkbox{margin:0}
.cbx-mkt .cbx-card .radgroup{display:flex;flex-wrap:wrap;gap:.35rem 1.6rem}
.cbx-mkt .cbx-card div[style*="float"]{float:none!important}
.cbx-mkt .cbx-card input[data-type=yesno]{width:1.45rem;height:1.45rem;margin:0}
.cbx-mkt .cbx-card label.radio,.cbx-mkt .cbx-card label.form-check-label{margin:0;font-weight:500;cursor:pointer}
.cb_bootstrap .btcalctoolbar{float:none!important;width:100%!important;margin:1.4rem 0 1.6rem!important;text-align:center;padding:0}
.cb_bootstrap .row-fluid{width:100%}
.cb_bootstrap .btcalctoolbar input.btn.btn-primary{background:linear-gradient(135deg,#be123c,#fb7185);border:0;color:#fff;font-weight:700;font-size:1.05rem;padding:.8rem 2.4rem;border-radius:999px;box-shadow:0 6px 16px #be123c44;transition:transform .15s,box-shadow .15s;cursor:pointer}
.cb_bootstrap .btcalctoolbar input.btn.btn-primary:hover{transform:translateY(-1px);box-shadow:0 10px 22px #be123c55}
.cb_bootstrap .btcalctoolbar input.btn.btn-primary:focus-visible{outline:3px solid #be123c66;outline-offset:2px}
.cbx-mkt-res{--a:#be123c;--a2:#fb7185;--soft:#fff1f2;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;color:var(--ink)}
.cbx-mkt-res .cbx-hero{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1rem;margin-bottom:1rem}
.cbx-mkt-res .cbx-hero-card{position:relative;overflow:hidden;color:#fff;border-radius:16px;padding:1.4rem 1.5rem;background:linear-gradient(135deg,var(--a),var(--a2));box-shadow:0 8px 20px #be123c33}
.cbx-mkt-res .cbx-hero-card:nth-child(2){background:linear-gradient(135deg,#0f172a,#334155);box-shadow:0 8px 20px rgba(15,23,42,.25)}

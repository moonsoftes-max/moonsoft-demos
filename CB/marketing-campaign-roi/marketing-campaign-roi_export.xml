                    <code><![CDATA[// ---- Marketing Campaign ROI ----
// $adspend = budget ($), $channel = google|facebook|linkedin|email (list value), $cpc = cost per click ($),
// $conv = click-to-order conversion rate (%), $aov = average order value ($), $margin = gross margin (%).
$fm = function ($v, $d = 0) { return number_format($v, $d, '.', ','); };

$spend = max(0, (float) $adspend);
$cpc_v = max(0.01, (float) $cpc);
$cv    = max(0, min(100, (float) $conv)) / 100;
$order = max(0, (float) $aov);
$gm    = max(0, min(100, (float) $margin)) / 100;

// typical click-through rate of each channel, used to estimate impressions
$ctrs   = ['google' => 3.5, 'facebook' => 1.0, 'linkedin' => 0.6, 'email' => 2.5];
$names  = ['google' => 'Google Ads', 'facebook' => 'Facebook', 'linkedin' => 'LinkedIn', 'email' => 'Email'];
$ch     = isset($ctrs[$channel]) ? $channel : 'google';
$ctr    = $ctrs[$ch];

// funnel
$clicks_r = $spend / $cpc_v;
$imps_r   = $clicks_r / ($ctr / 100);
$orders_r = $clicks_r * $cv;

// money
$revenue = $orders_r * $order;
$cogs    = $revenue * (1 - $gm);                 // cost of goods sold
$gross   = $revenue - $cogs;                     // gross profit before ad spend
$profit  = $gross - $spend;                      // campaign profit after ad spend
$roi     = ($spend > 0) ? $profit / $spend * 100 : 0;
$roas    = ($spend > 0) ? $revenue / $spend : 0;
$cpa     = ($orders_r > 0) ? $spend / $orders_r : 0;
$be_roas = ($gm > 0) ? 1 / $gm : 0;              // ROAS at which profit is exactly zero

// revenue split bar: cost of goods | ad spend | profit
$tot  = max(1, $cogs + $spend + max(0, $profit));
$w_c  = (int) round($cogs / $tot * 100);
$w_s  = (int) round($spend / $tot * 100);
$w_p  = ($profit > 0) ? max(0, 100 - $w_c - $w_s) : 0;
if ($profit <= 0) { $w_s = 100 - $w_c; }
$p_cs = ($profit > 0) ? '<i style="width:' . $w_p . '%;background:#16a34a">' . $w_p . '%</i>' : '';

if ($profit >= 0) {
    $advice = 'Every $1 of ads brings back $' . $fm($roas, 2) . ' of revenue and $' . $fm($profit / max($spend, 0.01), 2) . ' of profit. At a ' . $fm($gm * 100, 0) . '% margin the campaign only needs a ROAS of ' . $fm($be_roas, 2) . 'x to break even.';
} else {
    $advice = 'The campaign loses $' . $fm(-$profit) . '. At a ' . $fm($gm * 100, 0) . '% margin you need a ROAS of at least ' . $fm($be_roas, 2) . 'x to break even, and this one reaches ' . $fm($roas, 2) . 'x. Lower the cost per click, lift conversion or raise the order value.';
}

// display strings
$ch_name    = $names[$ch];
$ctr_f      = $fm($ctr, 1);
$conv_f     = $fm($cv * 100, 1);
$imps       = $fm($imps_r);
$clicks     = $fm($clicks_r);
$orders     = $fm($orders_r);
$revenue_f  = $fm($revenue);
$spend_f    = $fm($spend);
$cogs_f     = $fm($cogs);
$profit_f   = ($profit < 0 ? '-$' : '$') . $fm(abs($profit));
$roi_f      = $fm($roi, 1) . '%';
$roas_f     = $fm($roas, 2) . 'x';
$be_roas_f  = $fm($be_roas, 2) . 'x';
$cpa_f      = '$' . $fm($cpa, 2);
$profit_lab = ($profit >= 0) ? 'Campaign profit' : 'Campaign loss';
]]></code>

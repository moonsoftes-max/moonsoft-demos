.cbx-sav-res .cbx-col .sb{background:var(--a2);border-radius:4px 4px 0 0}
.cbx-sav-res .cbx-xl{display:flex;gap:3px;font-size:.7rem;color:var(--muted);margin-top:.3rem}
.cbx-sav-res .cbx-xl span{flex:1;text-align:center;min-width:0;overflow:visible;white-space:nowrap}

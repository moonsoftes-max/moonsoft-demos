.cbx-sav-res .cbx-table{width:100%;border-collapse:collapse;font-size:.92rem}
.cbx-sav-res .cbx-table th{text-align:left;font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:.5rem .6rem;border-bottom:2px solid var(--line)}
.cbx-sav-res .cbx-table td{padding:.5rem .6rem;border-bottom:1px solid var(--line)}
.cbx-sav-res .cbx-table .r{text-align:right}
.cbx-sav-res .cbx-gaugewrap{position:relative;padding-top:8px}
.cbx-sav-res .cbx-gauge{display:flex;height:14px;border-radius:999px;overflow:hidden}
.cbx-sav-res .cbx-gauge i{display:block;height:100%}
.cbx-sav-res .cbx-pin{position:absolute;top:0;width:5px;height:30px;background:#0f172a;border-radius:3px;transform:translateX(-50%);box-shadow:0 0 0 2px #fff}
.cbx-sav-res .cbx-ticks{position:relative;height:1.3rem;margin:.4rem 12px 0;font-size:.78rem;color:var(--muted)}

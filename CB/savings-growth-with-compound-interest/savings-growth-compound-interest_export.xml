                    <code><![CDATA[// ---- Savings Growth (spreadsheet powered) ----
// The workbook does all the finance maths. The //[EXCEL] marker below is replaced by Calc Builder
// with the code that writes $initial, $monthly, $rate, $years into B3:B6, recalculates the workbook
// and reads B8:B10 back into $final_balance, $total_contrib, $total_interest.
// Afterwards $objPHPExcel is the loaded workbook, so we can also read the yearly table (A14:D53).

//[EXCEL]

$sheet = $objPHPExcel->getSheet(0);
$n = max(1, min(40, (int) $years));

$data = [];
$max  = 0;
for ($r = 14; $r <= 13 + $n; $r++) {
    $c = (float) $sheet->getCell("B$r")->getCalculatedValue();
    $b = (float) $sheet->getCell("D$r")->getCalculatedValue();
    $data[] = [$r - 13, $c, $b - $c];
    $max = max($max, $b);
}

$chart  = '<div class="cbx-chart" role="img" aria-label="Balance by year, contributions and interest">';
$labels = '<div class="cbx-xl" aria-hidden="true">';
foreach ($data as [$yr, $c, $i]) {
    $hc = $max > 0 ? round($c / $max * 100, 1) : 0;
    $hi = $max > 0 ? round($i / $max * 100, 1) : 0;
    $chart  .= '<div class="cbx-col" title="Year ' . $yr . '"><div class="sb" style="height:' . $hi . '%"></div><div class="sa" style="height:' . $hc . '%"></div></div>';
    $show = ($yr == 1 || $yr == $n || ($n > 12 && $yr % 5 == 0) || ($n <= 12));
    $labels .= '<span>' . ($show ? $yr : '') . '</span>';
}
$chart .= '</div>' . $labels . '</div>';

// mapped output cells come back as *formatted* text ("171,362.02"), so strip the thousands separator
$fin  = (float) str_replace(',', '', (string) $final_balance);
$con  = (float) str_replace(',', '', (string) $total_contrib);
$int  = (float) str_replace(',', '', (string) $total_interest);
$share = ($fin > 0) ? round($int / $fin * 100) : 0;

// display strings (overwrite in place, as in the other examples)
$final_balance  = number_format($fin, 0, '.', ',');
$total_contrib  = number_format($con, 0, '.', ',');
$total_interest = number_format($int, 0, '.', ',');
$initial_f      = number_format((float) $initial, 0, '.', ',');
$monthly_f      = number_format((float) $monthly, 0, '.', ',');
$rate_f         = rtrim(rtrim(number_format((float) $rate, 2, '.', ''), '0'), '.');
$years          = $n;
]]></code>

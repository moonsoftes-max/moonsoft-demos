                    <code><![CDATA[use Joomla\CMS\Factory;

// ---- Solar Panel Savings calculator ----
// Inputs (Number fields): $system_size (kW), $cost_per_watt ($/W), $avg_monthly_bill ($),
// $sunlight_hours (peak sun hours/day), $electricity_rate ($/kWh), $incentive_percent (%)

$size          = (float) $system_size;
$price_watt    = (float) $cost_per_watt;
$bill          = (float) $avg_monthly_bill;
$sun_hours     = (float) $sunlight_hours;
$rate          = (float) $electricity_rate;
$incentive_pct = (float) $incentive_percent;

// ---- Core math ----
$gross_cost      = $size * 1000 * $price_watt;
$net_cost        = $gross_cost * (1 - $incentive_pct / 100);
$monthly_kwh     = $size * $sun_hours * 30;
$monthly_savings = min($monthly_kwh * $rate, $bill);
$annual_savings  = $monthly_savings * 12;
$payback_years   = $annual_savings > 0 ? $net_cost / $annual_savings : 0;
$savings_25yr    = ($annual_savings * 25) - $net_cost;

$incentive_amount = $gross_cost - $net_cost;
$capped_note = (($monthly_kwh * $rate) > $bill)
    ? '<br><i class="fa fa-circle-info"></i> Savings are capped at your current average bill &mdash; this system produces more energy than you currently use.'
    : '';

// ---- Display formatting (overwrite in place, same convention as the Loan Calculator demo) ----
$gross_cost          = number_format($gross_cost, 0, '.', ',');
$net_cost             = number_format($net_cost, 0, '.', ',');
$incentive_amount     = number_format($incentive_amount, 0, '.', ',');
$monthly_savings      = number_format($monthly_savings, 2, '.', ',');
$annual_savings       = number_format($annual_savings, 0, '.', ',');
$savings_25yr         = number_format($savings_25yr, 0, '.', ',');
$payback_years        = number_format($payback_years, 1, '.', ',');
$monthly_kwh          = number_format($monthly_kwh, 0, '.', ',');
$avg_monthly_bill_f   = number_format((float) $avg_monthly_bill, 0, '.', ',');
$system_size_f        = number_format((float) $system_size, 1, '.', ',');
$incentive_percent_f  = number_format((float) $incentive_percent, 0, '.', ',');
]]></code>

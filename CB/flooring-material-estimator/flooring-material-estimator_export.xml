                    <code><![CDATA[// ---- Flooring Material Estimator (spreadsheet powered) ----
// The workbook holds the price table (Prices sheet) and does the maths (Estimator sheet). The //[EXCEL] marker below
// is replaced by Calc Builder with code that writes the five inputs into B4:B8, recalculates the workbook and reads
// ten result cells back into PHP variables ($floor_name ... $area_bought).
// Afterwards $objPHPExcel is the loaded workbook, so we can also read the Prices sheet for the comparison.

//[EXCEL]

// mapped output cells come back as *formatted* text ("1,924.56", "13.0"): strip separators before arithmetic
$num = function ($v) { return (float) str_replace([',', '%', ' '], '', (string) $v); };

$area   = $num($room_area);
$waste  = $num($waste_total);
$buy    = $num($area_buy);
$packs_n = (int) round($num($packs));
$cover  = $num($pack_cov);
$cost   = $num($total_cost);
$cost_sq = $num($cost_m2);
$bought = $num($area_bought);
$extra  = max(0, $bought - $area);                       // flooring left over after the job

// the Prices sheet: one row per floor type, columns G/H already recalculated for this room by the workbook
$prices = $objPHPExcel->getSheet(1);
$cmp = [];
$max = 0;
$min = null;
for ($r = 2; $r <= 5; $r++) {
    $nm = (string) $prices->getCell("B$r")->getValue();
    $c  = (float) $prices->getCell("H$r")->getCalculatedValue();
    $pk = (int) $prices->getCell("G$r")->getCalculatedValue();
    $pm = (float) $prices->getCell("C$r")->getCalculatedValue();
    $cmp[] = [$nm, $c, $pk, $pm];
    $max = max($max, $c);
    if ($min === null || $c < $min) { $min = $c; }
}
$bars = '';
$cheapest = '';
foreach ($cmp as [$nm, $c, $pk, $pm]) {
    $w   = $max > 0 ? round($c / $max * 100, 1) : 0;
    $on  = ($nm === (string) $floor_name);
    $low = (abs($c - $min) < 0.005);
    if ($low) { $cheapest = $nm; }
    $bars .= '<div class="fl-row' . ($on ? ' on' : '') . '"><div class="fl-top"><span class="fl-n">' . $nm
           . ($on ? ' <em>your choice</em>' : '') . ($low ? ' <u>lowest</u>' : '') . '</span>'
           . '<span class="fl-v">$' . number_format($c, 2, '.', ',') . '</span></div>'
           . '<div class="fl-bar"><i style="width:' . $w . '%"></i></div>'
           . '<div class="fl-s">' . $pk . ' packs at $' . number_format($pm, 2, '.', ',') . ' per m&sup2;</div></div>';
}
$cmp_bars = $bars;
$cmp_note = 'Same room, same layout (' . strtolower($layout_name) . '), priced on every floor type in the workbook. Lowest total: ' . $cheapest . '.';

// room sketch: the rectangle keeps the room's proportions; the pattern follows the layout, the colour the floor type
$L = max(0.5, (float) $room_len);
$W = max(0.5, (float) $room_wid);
$ratio = round(max(0.6, min(2.6, $L / $W)), 3);
$tones = ['1' => ['#d9b98d', '#bd9a6c'], '2' => ['#cbc4ba', '#a99f92'], '3' => ['#b57e52', '#8f5c36'], '4' => ['#e2e6eb', '#b4bcc7']];
$tn = isset($tones[(string) $ftype]) ? $tones[(string) $ftype] : $tones['3'];
$is_tile = ((string) $ftype === '4');
$seam = 'rgba(15,23,42,.22)';
if ($pattern === '3') {            // herringbone: chevron
    $room_bg = 'background-color:' . $tn[0] . ';background-image:linear-gradient(135deg,' . $tn[1] . ' 25%,transparent 25%),linear-gradient(225deg,' . $tn[1]
             . ' 25%,transparent 25%),linear-gradient(315deg,' . $tn[1] . ' 25%,transparent 25%),linear-gradient(45deg,' . $tn[1] . ' 25%,transparent 25%);'
             . 'background-size:44px 44px;background-position:-22px 0,-22px 0,0 0,0 0';
} elseif ($pattern === '2') {      // diagonal
    $room_bg = 'background-color:' . $tn[0] . ';background-image:repeating-linear-gradient(45deg,' . $seam . ' 0 2px,transparent 2px ' . ($is_tile ? '40px' : '20px') . ')'
             . ($is_tile ? ',repeating-linear-gradient(-45deg,' . $seam . ' 0 2px,transparent 2px 40px)' : '');
} else {                           // straight
    $room_bg = 'background-color:' . $tn[0] . ';background-image:repeating-linear-gradient(0deg,' . $seam . ' 0 2px,transparent 2px ' . ($is_tile ? '40px' : '20px') . ')'
             . ($is_tile ? ',repeating-linear-gradient(90deg,' . $seam . ' 0 2px,transparent 2px 40px)' : '');
}
$room_ratio = $ratio;
$room_dims  = number_format($L, 2, '.', ',') . ' &times; ' . number_format($W, 2, '.', ',') . ' m';
$alc        = (float) $alcove;
$room_sum   = $room_dims . ($alc > 0 ? ' + ' . number_format($alc, 2, '.', ',') . ' m&sup2; alcove' : '') . ' = ' . number_format($area, 2, '.', ',') . ' m&sup2;';

// display strings (overwrite in place, as in the other examples)
$room_area   = number_format($area, 2, '.', ',');
$waste_txt   = number_format($waste, 1, '.', ',');
$area_buy    = number_format($buy, 2, '.', ',');
$packs       = number_format($packs_n);
$pack_cov    = number_format($cover, 2, '.', ',');
$area_bought = number_format($bought, 2, '.', ',');
$extra_txt   = number_format($extra, 2, '.', ',');
$total_cost  = number_format($cost, 2, '.', ',');
$cost_m2     = number_format($cost_sq, 2, '.', ',');
$packs_word  = ($packs_n == 1) ? 'pack' : 'packs';
]]></code>
